# Class: :MATSUS_0000062 (end of use disposition assessment)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000062 "MKB2 end-of-use architecture final human decision, 2026-09-20")
AnnotationAssertion(rdfs:label :MATSUS_0000062 "end of use disposition assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000062 "An assessment process that evaluates a material entity to determine the suitability of one or more subsequent end of use management processes."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000062 "Relevant evidence may include condition, functionality, safety, reparability, reusability, remanufacturability, recyclability, composition, or other criteria relevant to selecting a subsequent management pathway."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000062 "The assessment is distinct from the subsequent management process and does not imply that a recommended pathway is selected or executed. Functionality assessments, assays, and other analyses may provide evidence for the assessment."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000062 "MKB2 end-of-use competency questions and existing MatSus assessment architecture; final human decision, 2026-09-20.")
AnnotationAssertion(:integrationMethod :MATSUS_0000062 "MatSus-local assessment-process specialization using the existing evaluates relation")
SubClassOf(:MATSUS_0000062 :MATSUS_0000043)
SubClassOf(:MATSUS_0000062 ObjectSomeValuesFrom(:MATSUS_0000060 <http://purl.obolibrary.org/obo/BFO_0000040>))

# Class: :MATSUS_0000063 (end of use disposition recommendation)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000063 "MKB2 end-of-use architecture final human decision, 2026-09-20")
AnnotationAssertion(rdfs:label :MATSUS_0000063 "end of use disposition recommendation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000063 "Assessment result information that recommends one or more end of use management processes for an evaluated material entity."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000063 "A disposition recommendation is distinct from a decision authorizing a pathway and from the subsequent management process itself. It may be supported by other assessment result information concerning condition, functionality, composition, safety, or other relevant characteristics."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000063 "No universal is-about existential is asserted in this increment. In complete local records, consistency between the assessment's evaluated material entity and the recommendation's aboutness target is to be checked in the application-profile/SHACL layer."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000063 "MKB2 end-of-use competency questions and existing MatSus assessment-result architecture; final human decision, 2026-09-20.")
AnnotationAssertion(:integrationMethod :MATSUS_0000063 "MatSus-local specialization of assessment result information")
SubClassOf(:MATSUS_0000063 :MATSUS_0000055)

