# Class: :MATSUS_0000059 (assessment report)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000059 "MKB2 SRC-005/SRC-006 final human decision, 2026-09-16")
AnnotationAssertion(rdfs:label :MATSUS_0000059 "assessment report"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000059 "A document that organizes or communicates assessment result information concerning one or more assessment processes."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000059 "An assessment report is not identical to an individual result. It may have result information as actual content or be about an external result; those cases require different assertions."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000059 "MKB1 assessment-report carryover, imported IAO document, and current MatSus report review; final human decisions 5 and 11.")
