############################
#   Object Properties
############################

# Object Property: :MATSUS_0000060 (evaluates)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000060 "An evaluand may be a material, product, process, or represented lifecycle system. This optional relation does not imply participation, input, material-evaluant status, or information aboutness. Its SSbD correspondence is non-entailing and does not carry proper-overlap or PROV domain and range semantics. No inverse is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000060 "evaluates"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000060 "A relation between an assessment process and an entity such that the process determines or estimates a characteristic, performance, impact, condition, or outcome concerning that entity for an assessment objective."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000060 "related property correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000060 <https://w3id.org/ssbd/assesses>)
ObjectPropertyDomain(:MATSUS_0000060 :MATSUS_0000043)
ObjectPropertyRange(:MATSUS_0000060 <http://purl.obolibrary.org/obo/BFO_0000001>)

# Object Property: :MATSUS_0000061 (has indicator specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000061 "This links an indicator result to the metric specification governing it. It expresses methodological governance rather than aboutness, parthood or a link to the value specification carrying the result. SSbD and CLEO do not supply a property with this scope. No inverse is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000061 "has indicator specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000061 "A relation between an indicator result and a metric specification such that the specification prescribes the quantities, calculation or measurement method, units, boundary, or interpretation by which the result is determined."@en)
ObjectPropertyDomain(:MATSUS_0000061 :MATSUS_0000057)
ObjectPropertyRange(:MATSUS_0000061 :MATSUS_0000027)

# Object Property: :MATSUS_0000064 (recommends)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000064 "A recommendation identifies a suitable end-of-use management process without authorizing, formally selecting, or executing it. Multiple pathways may be recommended. No functionality or inverse-property axiom is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000064 "recommends"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000064 "Relates an end of use disposition recommendation to an end of use management process that the recommendation identifies as suitable for the evaluated material entity."@en)
ObjectPropertyDomain(:MATSUS_0000064 :MATSUS_0000063)
ObjectPropertyRange(:MATSUS_0000064 :MATSUS_0000000)



############################
#   Classes
############################

# Class: :BatteryCarbonFootprintInformation (battery carbon footprint result)

AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryCarbonFootprintInformation <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryCarbonFootprintInformation "BatteryPass-ready Data Attribute Long List v1.3, attributes 28-35")
AnnotationAssertion(rdfs:label :BatteryCarbonFootprintInformation "battery carbon footprint result"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :BatteryCarbonFootprintInformation "battery carbon footprint information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :BatteryCarbonFootprintInformation "A carbon footprint result that quantifies greenhouse gas emissions and removals associated with a battery under a specified method, system boundary, and functional unit."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :BatteryCarbonFootprintInformation "This is a calculated indicator result, not an intrinsic material quality. It may be contained in a Digital Product Passport or another information artifact; DPP containment is not part of the class definition."@en)
SubClassOf(:BatteryCarbonFootprintInformation :MATSUS_0000076)

# Class: :BatteryLabelInformation (battery label information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryLabelInformation <urn:samm:io.BatteryPass.Labels:1.2.0#labels>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryLabelInformation "BatteryPass-ready Data Attribute Long List v1.3, attributes 21-25")
AnnotationAssertion(rdfs:label :BatteryLabelInformation "battery label information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :BatteryLabelInformation "DPP information about labels, symbols, and their meanings that are attached to or applicable to a battery."@en)
SubClassOf(:BatteryLabelInformation <http://w3id.org/dppo/ontology/dpp-info/DPPInformation>)

# Class: :BatteryModelSpecification (battery model specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryModelSpecification "BatteryPass-ready Data Attribute Long List v1.3, attribute 7")
AnnotationAssertion(rdfs:label :BatteryModelSpecification "battery model specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :BatteryModelSpecification "A material specification that describes a battery model."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :BatteryModelSpecification "Represent model-level information as a material specification. Distinguish batches and individual items using lot or batch patterns and identifiers, without inferring a new product-batch hierarchy."@en)
SubClassOf(:BatteryModelSpecification <https://w3id.org/pmd/co/PMD_0060007>)

# Class: :DPPGranularityDatum (DPP granularity datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :DPPGranularityDatum "BatteryPass-ready Data Attribute Long List v1.3, attribute 3")
AnnotationAssertion(rdfs:label :DPPGranularityDatum "DPP granularity datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :DPPGranularityDatum "A data item that records whether the product identifier associated with a Digital Product Passport denotes a product model, batch, or individual item."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :DPPGranularityDatum "Granularity is represented with literal values for application-profile validation. Use the existing PMDco/LOG lot alignment and LOG batch identifier to represent batch granularity."@en)
SubClassOf(:DPPGranularityDatum <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: :DPPStatusDatum (DPP status datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :DPPStatusDatum "BatteryPass-ready Data Attribute Long List v1.3, attribute 2")
AnnotationAssertion(rdfs:label :DPPStatusDatum "DPP status datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :DPPStatusDatum "A data item that records the lifecycle status of a Digital Product Passport as a digital resource."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :DPPStatusDatum "Status is represented with literal values for application-profile validation. The ontology supplies no controlled OWL or SKOS vocabulary for those values."@en)
SubClassOf(:DPPStatusDatum <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: :DeclarationOfConformity (declaration of conformity)

AnnotationAssertion(<http://purl.org/dc/terms/source> :DeclarationOfConformity <urn:samm:io.BatteryPass.Labels:1.2.0#declarationOfConformity>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :DeclarationOfConformity "BatteryPass-ready Data Attribute Long List v1.3, attribute 26")
AnnotationAssertion(rdfs:label :DeclarationOfConformity "declaration of conformity"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :DeclarationOfConformity "A document declaring that a product conforms to specified legal or technical requirements."@en)
SubClassOf(:DeclarationOfConformity <http://purl.obolibrary.org/obo/IAO_0000310>)

# Class: :DigitalProductPassportIdentifier (Digital Product Passport identifier)

AnnotationAssertion(<http://purl.org/dc/terms/source> :DigitalProductPassportIdentifier "BatteryPass-ready Data Attribute Long List v1.3, attribute 5")
AnnotationAssertion(rdfs:label :DigitalProductPassportIdentifier "Digital Product Passport identifier"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :DigitalProductPassportIdentifier "An identifier that denotes a specific Digital Product Passport or passport version."@en)
SubClassOf(:DigitalProductPassportIdentifier <http://purl.obolibrary.org/obo/IAO_0020000>)
SubClassOf(:DigitalProductPassportIdentifier ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000219> <http://w3id.org/dppo/ontology/dpp-odp/DPP>))

# Class: :EndOfLifeInformation (end-of-use information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :EndOfLifeInformation "BatteryPass-ready Data Attribute Long List v1.3, attributes 56-58")
AnnotationAssertion(rdfs:label :EndOfLifeInformation "end-of-use information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :EndOfLifeInformation "end-of-life information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :EndOfLifeInformation "An information content entity that is about the management of a material entity when it has reached or is approaching the end of a use phase, including collection, preparation for further use, dismantling, treatment, recycling, recovery, or disposal."@en)
AnnotationAssertion(rdfs:comment :EndOfLifeInformation "For example, a battery Digital Product Passport may contain end-of-use information concerning collection, dismantling, preparation for further use, recycling, recovery, treatment, or disposal."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :EndOfLifeInformation "This class covers information about end-of-use handling. Use process or circular value-network models for the handling occurrences and their network relationships."@en)
SubClassOf(:EndOfLifeInformation <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :LifecycleStageCarbonFootprintContribution (battery lifecycle-stage carbon-footprint contribution)

AnnotationAssertion(<http://purl.org/dc/terms/source> :LifecycleStageCarbonFootprintContribution <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifeCycleStage>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :LifecycleStageCarbonFootprintContribution "BatteryPass-ready Data Attribute Long List v1.3, attributes 29-32")
AnnotationAssertion(rdfs:label :LifecycleStageCarbonFootprintContribution "battery lifecycle-stage carbon-footprint contribution"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :LifecycleStageCarbonFootprintContribution "lifecycle-stage carbon-footprint contribution"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :LifecycleStageCarbonFootprintContribution "A carbon footprint result that represents the contribution of a specified life-cycle stage to a battery carbon footprint result."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :LifecycleStageCarbonFootprintContribution "The contributes-to existential relates a stage result to the generic MatSus result-contribution pattern without requiring arithmetic summation or a unique contributing stage. Stage identifiers, values, units, functional units and calculation provenance belong in data and value patterns and can be checked in an application profile."@en)
SubClassOf(:LifecycleStageCarbonFootprintContribution :MATSUS_0000076)
SubClassOf(:LifecycleStageCarbonFootprintContribution ObjectSomeValuesFrom(:MATSUS_0000077 :BatteryCarbonFootprintInformation))

# Class: :MATSUS_0000001 (recovered material)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000001 "Recovery provenance can persist after the material ceases to bear a waste role. Recovery and waste-role status need separate descriptions. No disjointness or complement axiom is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000001 "recovered material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000001 "A material obtained through a material-recovery process from material that had been discarded, become waste, or left its preceding use, and that is made available for further use."@en)
SubClassOf(:MATSUS_0000001 <https://w3id.org/pmd/co/PMD_0000000>)

# Class: :MATSUS_0000002 (recycled material)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000002 "Recycled and secondary material can overlap. No disjointness between them is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000002 "recycled material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000002 "A recovered material produced through a recycling process in which waste material is reprocessed into a product, material, or substance for its original or another purpose."@en)
SubClassOf(:MATSUS_0000002 :MATSUS_0000001)

# Class: :MATSUS_0000003 (secondary material)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000003 "Secondary material is a positive recovery-derived category rather than the complement of virgin material. It may also be recycled material."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000003 "secondary material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000003 "A recovered material suitable for use in manufacturing or material processing instead of or alongside virgin material."@en)
SubClassOf(:MATSUS_0000003 :MATSUS_0000001)

# Class: :MATSUS_0000004 (material sustainability assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000004 "This class denotes a sustainability assessment with a material-related subject. An OBI or PMDco assay may supply evidence or occur within an assessment without being a universal superclass. The subject may be a material, product, process, or represented lifecycle system, and the assessment can also fall under environmental, economic or social aspects. The SSbD correspondence is conceptual and entails no inherited restrictions."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000004 "material sustainability assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000004 "A sustainability assessment that evaluates one or more sustainability-related aspects of a material, product, process, or material lifecycle system."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000004 "relatedMatch; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000004 <https://w3id.org/ssbd/SustainabilityAssessment>)
SubClassOf(:MATSUS_0000004 :MATSUS_0000048)

# Class: :MATSUS_0000005 (resource-input reduction assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000005 "The assessment evaluates resource-input reduction and is distinct from both the performance of a reduction process and the specification of its objective. Comparison depends on the evaluated system or process, baseline and conditions."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000005 "resource-input reduction assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000005 "A material sustainability assessment intended to determine or quantify whether, and to what extent, material input has been reduced relative to a stated baseline under specified comparison conditions."@en)
SubClassOf(:MATSUS_0000005 :MATSUS_0000004)

# Class: :MATSUS_0000006 (resource-input reduction objective specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000006 "A reduction strategy may prescribe actions to achieve it, without requiring a separate resource-input reduction strategy class."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000006 "An objective to reduce virgin aluminium input by 20% relative to the 2025 baseline."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000006 "resource-input reduction objective specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000006 "An objective specification that specifies an intended reduction, relative to a stated baseline and under specified comparison conditions, in the quantity of material input required or used by a specified process or system."@en)
SubClassOf(:MATSUS_0000006 <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: :MATSUS_0000007 (waste role)

AnnotationAssertion(rdfs:label :MATSUS_0000007 "obsolete waste role"@en)
AnnotationAssertion(owl:deprecated :MATSUS_0000007 "true"^^xsd:boolean)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000007 "Deprecated historical identifier retained for compatibility. Active use is replaced by ENVO_01000665 waste role, imported through PMDco v3.1.2. No equivalence or subclass mapping is asserted between the deprecated local identifier and ENVO_01000665.")

# Class: :MATSUS_0000008 (waste material)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000008 "Waste status is contextual and role-based. The ENVO waste-role restriction imported through PMDco v3.1.2 is necessary only. ENVO_01000665 is disjoint with a role borne by a PMDco portion of matter, so do not classify the bearer as PMD_0000001. Recovery provenance alone does not establish that a material still bears a waste role. This class does not encode role acquisition or loss."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000008 "waste material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000008 "waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000008 "A material entity that bears an ENVO waste role."@en)
SubClassOf(:MATSUS_0000008 <http://purl.obolibrary.org/obo/BFO_0000040>)
SubClassOf(:MATSUS_0000008 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/ENVO_01000665>))

# Class: :MATSUS_0000009 (construction and demolition waste)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000009 "This class specializes waste material by the scope stated in its definition. It has no additional source or provenance restriction."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000009 "construction and demolition waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000009 "A waste material that arises from construction or demolition activities."@en)
SubClassOf(:MATSUS_0000009 :MATSUS_0000008)

# Class: :MATSUS_0000010 (mineral waste)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000010 "No OWL cutoff is assigned to 'predominantly'. Record any quantitative threshold in the applicable data or classification specification."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000010 "mineral waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000010 "A waste material composed predominantly of mineral matter."@en)
SubClassOf(:MATSUS_0000010 :MATSUS_0000008)

# Class: :MATSUS_0000011 (municipal waste)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000011 "Municipal solid waste is an alternative label. The annotation entails no equivalent-class relationship."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000011 "municipal waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000011 "municipal solid waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000011 "A waste material collected from households or a waste material from another source that is similar in nature and composition to household waste."@en)
SubClassOf(:MATSUS_0000011 :MATSUS_0000008)

# Class: :MATSUS_0000012 (packaging waste)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000012 "The intended scope excludes production residues. The textual definition states that the material was packaging or packaging material before it acquired a waste role. The OWL axioms classify packaging waste under waste material without an explicit production-residue exclusion. A matching label alone does not establish scope agreement."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000012 "packaging waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000012 "A waste material that was packaging or packaging material before it acquired a waste role."@en)
SubClassOf(:MATSUS_0000012 :MATSUS_0000008)

# Class: :MATSUS_0000013 (textile waste)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000013 "This waste subtype has broad scope and does not impose fibre, composition, or product-type criteria beyond its definition."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000013 "textile waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000013 "A waste material composed predominantly of textile material or discarded textile products."@en)
SubClassOf(:MATSUS_0000013 :MATSUS_0000008)

# Class: :MATSUS_0000014 (collection system)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000014 "The object-aggregate placement groups the physical collection system without committing to fixed membership, function, responsible agents or collection-process relations."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000014 "collection system"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000014 "An object aggregate whose members are organized to enable one or more collection processes."@en)
SubClassOf(:MATSUS_0000014 <http://purl.obolibrary.org/obo/BFO_0000027>)

# Class: :MATSUS_0000015 (waste collection process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000015 "Generic waste collection also covers production, construction, process and other waste streams that need not arise after a use phase. It therefore sits outside the end-of-use management process hierarchy. A particular collection can qualify as end-of-use management when it handles waste arising after a use phase."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000015 "waste collection process"@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000015 "In MatSus, a waste collection process may be an end of use management process when the collected waste arises after a use phase."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000015 "A planned process in which waste material is gathered from one or more holders or locations for transport, storage, sorting, recovery, treatment, or disposal."@en)
SubClassOf(:MATSUS_0000015 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000016 (sorting process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000016 "This process performs sorting. The criteria or method specification and the identities of the sorted inputs and outputs belong to the description of an occurrence and are not further constrained here."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000016 "sorting process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000016 "A planned process in which material entities are assigned to different groups or streams according to specified criteria."@en)
SubClassOf(:MATSUS_0000016 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000017 (sorting method specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000017 "A sorting method specification is directive information describing how to sort. It is placed under plan specification rather than under the sorting process it can prescribe."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000017 "sorting method specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000017 "A plan specification that prescribes how a sorting process is to be carried out."@en)
SubClassOf(:MATSUS_0000017 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000018 (waste separation process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000018 "This is a sorting process specialized to waste material. No additional waste-input or separated-stream output restriction is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000018 "waste separation process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000018 "A sorting process in which waste material is assigned to different groups or streams according to specified criteria."@en)
SubClassOf(:MATSUS_0000018 :MATSUS_0000016)

# Class: :MATSUS_0000019 (waste generation process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000019 "Waste generation can occur in planned or unplanned contexts. A waste-material output is required, without the process necessarily being production or synthesis."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000019 "waste generation process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000019 "A process that has as output a material entity that bears a waste role."@en)
SubClassOf(:MATSUS_0000019 <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(:MATSUS_0000019 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> :MATSUS_0000008))

# Class: :MATSUS_0000020 (waste prevention process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000020 "This denotes a performed prevention process, distinct from the measure specification that prescribes how prevention should be carried out."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000020 "waste prevention process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000020 "A planned process that is intended to reduce the quantity or harmfulness of waste generated, or the adverse impacts of generated waste on the environment and human health."@en)
SubClassOf(:MATSUS_0000020 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000021 (waste prevention measure specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000021 "This information artifact prescribes a waste prevention measure. The process that carries it out is a separate entity."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000021 "waste prevention measure specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000021 "A plan specification that prescribes actions intended to realize a waste prevention process."@en)
SubClassOf(:MATSUS_0000021 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000022 (zero-waste objective specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000022 "Zero waste is the objective expressed by directive information. Any scope, baseline, or tolerated residual waste belongs to the stated objective or application profile."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000022 "zero-waste objective specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000022 "An objective specification that describes an intended endpoint in which waste generation and disposal are prevented or minimized through responsible production, consumption, reuse, and recovery."@en)
SubClassOf(:MATSUS_0000022 <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: :MATSUS_0000023 (zero-waste strategy specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000023 "The strategy specifies a plan to pursue a zero-waste objective. The objective and the performed prevention, reuse or recovery processes are distinct entities."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000023 "zero-waste strategy specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000023 "A plan specification that prescribes actions intended to achieve a zero-waste objective."@en)
SubClassOf(:MATSUS_0000023 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000024 (waste elimination objective specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000024 "This class specifies an objective for waste elimination. It does not denote a generic elimination process or extend the target to pollution without a separate scope specification."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000024 "waste elimination objective specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000024 "An objective specification that specifies the intended absence of a specified waste output within a stated scope."@en)
SubClassOf(:MATSUS_0000024 <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: :MATSUS_0000025 (waste analysis)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000025 "Waste analysis is an assay. Its evaluand, method and information outputs are distinct from the analysis process."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000025 "waste analysis"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000025 "An assay intended to produce information about waste material, a waste-generating process, or a waste stream."@en)
SubClassOf(:MATSUS_0000025 <http://purl.obolibrary.org/obo/OBI_0000070>)

# Class: :MATSUS_0000026 (structural waste analysis)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000026 "Recurring patterns of waste generation fall outside this definition."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000026 "structural waste analysis"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000026 "A waste analysis intended to produce information about the composition, organization, or distribution of material constituents within a waste material or waste stream."@en)
SubClassOf(:MATSUS_0000026 :MATSUS_0000025)

# Class: :MATSUS_0000027 (metric specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000027 "A metric specification prescribes how a metric is determined. It governs an indicator result through has indicator specification and is distinct from both the result datum and the OBI value specification carrying its value. SSbD Indicator and CLEO lifecycle model datum do not express this directive-information category."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000027 "indicator specification"@en)
AnnotationAssertion(rdfs:label :MATSUS_0000027 "metric specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000027 "A directive information entity that prescribes the quantities, calculation method, units, boundary, and interpretation used to produce a quantitative indicator datum."@en)
SubClassOf(:MATSUS_0000027 <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: :MATSUS_0000028 (resource efficiency datum)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000028 "This is a calculated result datum. Interpretation depends on its numerator or output, resource input, method, boundary, unit and time interval."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000028 "resource efficiency datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000028 "A data item that records the useful output, service, or value obtained per stated quantity of resource input under a specified method, boundary, and time interval."@en)
SubClassOf(:MATSUS_0000028 <http://purl.obolibrary.org/obo/IAO_0000027>)
SubClassOf(:MATSUS_0000028 :MATSUS_0000057)

# Class: :MATSUS_0000029 (material resource efficiency datum)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000029 "This specializes resource efficiency datum by using a material input. The class adds no restriction on the input quantity, method, unit or boundary."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000029 "material resource efficiency datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000029 "A resource efficiency datum whose stated resource input is a quantity of material."@en)
SubClassOf(:MATSUS_0000029 :MATSUS_0000028)

# Class: :MATSUS_0000030 (virgin material)

AnnotationAssertion(rdfs:comment :MATSUS_0000030 "Virgin material emphasizes the absence of recovery or recycling in the material's provenance. Primary material emphasizes production from natural-resource inputs. These usages may overlap, but their exact relationship is not yet formalized in MatSus."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000030 "virgin material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000030 "A material that is obtained from primary resources and has not undergone a recovery or recycling process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000030 "European regulatory and circular-economy terminology uses 'virgin material' in ways that may overlap with 'primary material', particularly when distinguishing material without recovered or recycled origin. MatSus currently asserts no equivalence, disjointness or hierarchy between virgin material and primary material. Sector-specific legal classifications may impose additional conditions.")
SubClassOf(:MATSUS_0000030 <https://w3id.org/pmd/co/PMD_0000000>)

# Class: :MATSUS_0000031 (repurposing process)

AnnotationAssertion(rdfs:label :MATSUS_0000031 "repurposing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000031 "A planned process in which a product, component, or material is prepared or modified so that it can fulfil a purpose different from its preceding intended purpose."@en)
SubClassOf(:MATSUS_0000031 :MATSUS_0000000)

# Class: :MATSUS_0000032 (battery repurposing process)

AnnotationAssertion(rdfs:label :MATSUS_0000032 "battery repurposing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000032 "A repurposing process whose primary participant is a battery or battery component."@en)
SubClassOf(:MATSUS_0000032 :MATSUS_0000031)

# Class: :MATSUS_0000033 (resource-input reduction process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000033 "This is the process of reducing resource input, distinct from assessing a reduction or specifying a reduction objective. Interpret comparisons against the stated baseline, conditions and comparable output or function."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000033 "resource-input reduction process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000033 "A planned process intended to reduce the amount of material input used by a specified process or system."@en)
SubClassOf(:MATSUS_0000033 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000034 (refill process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000034 "The same process class covers at-home and on-the-go refilling. These are occurrence contexts and do not define distinct subclasses."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000034 "refill process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000034 "A planned process in which a product container or dispensing device is supplied again with a material product for further use without first becoming waste."@en)
SubClassOf(:MATSUS_0000034 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000035 (refusal process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000035 "This class denotes the actual intentional refusal occurrence. A strategy or objective that motivates or prescribes refusal is a separate information entity."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000035 "refusal process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000035 "A planned process in which an agent intentionally declines to acquire, accept, or use a specified product, material, or service in order to avoid its associated resource use or waste generation."@en)
SubClassOf(:MATSUS_0000035 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000036 (remanufacturing process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000036 "Remanufacturing requires reprocessing to meet the performance and quality requirements of an equivalent new product. Refurbishment restores performance or functionality within the originally intended use and performance range. Regulation (EU) 2024/1781 uses a different remanufacturing scope, requiring a new product and a substantial change affecting safety, performance, purpose or type. No equivalence, subclass or disjointness relationship with refurbishment is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000036 "remanufacturing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000036 "A planned process that reprocesses used products or components to produce a product meeting the performance and quality requirements of an equivalent new product."@en)
SubClassOf(:MATSUS_0000036 :MATSUS_0000000)

# Class: :MATSUS_0000037 (decoupling datum)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000037 "This datum records decoupling in the sustainability and resource-efficiency sense. Interpretation depends on the relationship between resource input or environmental pressure and economic or service output over a comparison interval. It does not describe dismantling, disassembly or physical separation."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000037 "decoupling datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000037 "A data item that records a comparison over a stated time interval in which the rate of change of a resource input or environmental pressure is lower than the rate of change of a specified economic or service output."@en)
SubClassOf(:MATSUS_0000037 <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: :MATSUS_0000038 (modularity)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000038 "Modularity is a dependent quality of a bearer. Its degree and measurement can be recorded separately from the bearer and its physical components."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000038 "modularity"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000038 "A quality of an entity that reflects the degree to which its parts are organized into separable, replaceable, or recombinable modules."@en)
SubClassOf(:MATSUS_0000038 <http://purl.obolibrary.org/obo/BFO_0000019>)

# Class: :MATSUS_0000039 (refusal strategy specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000039 "This plan specification prescribes a refusal strategy. A refusal occurrence need not realize such a strategy, and the ontology asserts no universal realization link."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000039 "Examples include optional packaging, opt-out disposable accessories, and service provision that avoids supplying a material product. This class denotes the strategy specification; the actual refusal occurrence is represented by refusal process."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000039 "refusal strategy specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000039 "A plan specification that prescribes product, packaging, or service features intended to enable or encourage a refusal process and thereby avoid material use or waste generation."@en)
SubClassOf(:MATSUS_0000039 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000040 (primary material)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000040 "The definition uses the provenance-based sense of primary material in European circular-economy discourse. MatSus asserts no equivalence, disjointness or hierarchy between primary and virgin material."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000040 "Primary material includes material obtained through extraction or harvesting and any subsequent processing of natural-resource inputs. In circular-economy usage, it is contrasted with material originating from recovery or recycling."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000040 "primary material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000040 "A material produced from natural resources without recovered material as its material source."@en)
SubClassOf(:MATSUS_0000040 <https://w3id.org/pmd/co/PMD_0000000>)

# Class: :MATSUS_0000041 (primary raw material)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000041 "The LOG raw-material-role pattern distinguishes primary provenance from use or intended use as a production input. Sector-specific uses of 'virgin raw material' may impose different conditions."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000041 "Primary raw material combines primary material provenance with the context of being used or intended as an input to production. A primary material need not be a primary raw material when it does not bear the raw material role."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000041 "primary raw material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000041 "A primary material that has a raw material role."@en)
SubClassOf(:MATSUS_0000041 <https://w3id.org/pmd/log/LOG_1000102>)
SubClassOf(:MATSUS_0000041 :MATSUS_0000040)

# Class: :MATSUS_0000042 (secondary raw material)

AnnotationAssertion(rdfs:comment :MATSUS_0000042 "Secondary raw material combines recovery-derived material provenance with the context of being used or intended as an input to production. A secondary material need not be a secondary raw material when it does not bear the raw material role."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000042 "secondary raw material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000042 "A secondary material that has a raw material role."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000042 "European circular-economy terminology commonly uses 'secondary raw material' for recovery-derived material returned to production. This class applies the LOG raw-material-role pattern to the existing MatSus secondary material class. No equivalence with recovered material or recycled material is asserted.")
SubClassOf(:MATSUS_0000042 <https://w3id.org/pmd/log/LOG_1000102>)
SubClassOf(:MATSUS_0000042 :MATSUS_0000003)

# Class: :MATSUS_0000043 (assessment process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000043 "This BFO/COB planned-process class covers ongoing, completed, and incompletely described assessments. No universal specification, evaluand, input, or output existential is asserted. The SSbD correspondence is conceptual and does not inherit its output, assesses, PROV or mereology axioms."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000043 "assessment process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000043 "A planned process that evaluates an entity, characteristic, performance, impact, or condition in order to produce information relevant to a stated objective."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000043 "relatedMatch; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000043 <https://w3id.org/ssbd/Assessment>)
AnnotationAssertion(:mappedTo :MATSUS_0000043 <https://w3id.org/ssbd/SpecifiedAssessment>)
SubClassOf(:MATSUS_0000043 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000044 (safety assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000044 "This umbrella class neither entails regulatory compliance nor requires all three child kinds. The SSbD correspondence is conceptual and carries no inherited restrictions."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000044 "safety assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000044 "An assessment process that evaluates hazards, exposures, risks, or other safety-relevant conditions."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000044 "close conceptual correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000044 <https://w3id.org/ssbd/SafetyAssessment>)
SubClassOf(:MATSUS_0000044 :MATSUS_0000043)

# Class: :MATSUS_0000045 (hazard assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000045 "This umbrella is broader than the SSbD environment, human-health and intrinsic chemical hazard assessment terms. It denotes a process, distinct from an assessment result or a hazard disposition."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000045 "hazard assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000045 "A safety assessment that identifies or characterizes the potential of an entity or condition to cause harm."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000045 "broader local umbrella over several SSbD leaves; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000045 <https://w3id.org/ssbd/HazardAssessmentEnvironment>)
AnnotationAssertion(:mappedTo :MATSUS_0000045 <https://w3id.org/ssbd/HazardAssessmentHumanHealth>)
AnnotationAssertion(:mappedTo :MATSUS_0000045 <https://w3id.org/ssbd/IntrinsicChemicalHazardAssessment>)
SubClassOf(:MATSUS_0000045 :MATSUS_0000044)

# Class: :MATSUS_0000046 (exposure assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000046 "Exposure assessment denotes the process. SSbD result-like wording does not define the MatSus class, and the model does not introduce a separate exposure-estimate information class."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000046 "exposure assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000046 "A safety assessment that evaluates the magnitude, frequency, duration, route, or circumstances of contact between an agent and an entity of concern."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000046 "broader local umbrella; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000046 <https://w3id.org/ssbd/ExposureAssessmentEnvironment>)
AnnotationAssertion(:mappedTo :MATSUS_0000046 <https://w3id.org/ssbd/ExposureAssessmentHumanHealth>)
SubClassOf(:MATSUS_0000046 :MATSUS_0000044)

# Class: :MATSUS_0000047 (risk assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000047 "Risk assessment denotes the process. Its risk estimate is resulting information. This distinction matters for interpreting the conceptual SSbD correspondence, since its environmental risk assessment uses estimate-like wording."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000047 "risk assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000047 "A safety assessment that evaluates the likelihood and severity of harm under specified hazard, exposure, and contextual conditions."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000047 "broader local process correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000047 <https://w3id.org/ssbd/EnvironmentalRiskAssessment>)
AnnotationAssertion(:mappedTo :MATSUS_0000047 <https://w3id.org/ssbd/HumanHealthRiskAssessment>)
SubClassOf(:MATSUS_0000047 :MATSUS_0000044)

# Class: :MATSUS_0000048 (sustainability assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000048 "An assessment need not cover all three sustainability dimensions. The aspect branches are neither disjoint nor exhaustive, and the conceptual SSbD correspondence does not carry its dimension restrictions."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000048 "sustainability assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000048 "An assessment process that evaluates one or more environmental, economic, or social sustainability aspects of an entity or process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000048 "close conceptual correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000048 <https://w3id.org/ssbd/SustainabilityAssessment>)
SubClassOf(:MATSUS_0000048 :MATSUS_0000043)

# Class: :MATSUS_0000049 (environmental sustainability assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000049 "Impact categories, environmental effects and indicator results are distinct from the assessment process. Life cycle assessment processes sit under sustainability assessment, and the conceptual SSbD correspondence introduces no SSbD impact-category descendants."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000049 "environmental sustainability assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000049 "A sustainability assessment that evaluates environmental sustainability aspects of an entity or process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000049 "close conceptual correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000049 <https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment>)
SubClassOf(:MATSUS_0000049 :MATSUS_0000048)

# Class: :MATSUS_0000050 (economic sustainability assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000050 "This class provides a general economic sustainability assessment anchor. Its SSbD correspondence is annotation-only, and no method, criterion, specialized result or child is specified."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000050 "economic sustainability assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000050 "A sustainability assessment that evaluates economic sustainability aspects of an entity or process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000050 "thin-anchor correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000050 <https://w3id.org/ssbd/EconomicSustainabilityAssessment>)
SubClassOf(:MATSUS_0000050 :MATSUS_0000048)

# Class: :MATSUS_0000051 (social sustainability assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000051 "This class provides a general social sustainability assessment anchor. Its SSbD correspondence is annotation-only, and no method, criterion, specialized result or child is specified."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000051 "social sustainability assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000051 "A sustainability assessment that evaluates social sustainability aspects of an entity or process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000051 "thin-anchor correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000051 <https://w3id.org/ssbd/SocialSustainabilityAssessment>)
SubClassOf(:MATSUS_0000051 :MATSUS_0000048)

# Class: :MATSUS_0000052 (sustainability-relevant functionality assessment)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000052 "Functionality assessment here requires a sustainability or safe-and-sustainable-by-design decision context. Ordinary characterization assays can provide evidence or occur as subprocesses without automatically falling under this class."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000052 "sustainability-relevant functionality assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000052 "An assessment process that evaluates whether or how well an entity or process fulfils a stated function or performance requirement in a sustainability or SSbD decision context."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000052 "narrower MatSus correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000052 <https://w3id.org/ssbd/FunctionalityAssessment>)
SubClassOf(:MATSUS_0000052 :MATSUS_0000043)

# Class: :MATSUS_0000053 (assessment specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000053 "An assessment specification is directive information and inherits plan-specification requirements for objective and action specification parts. A retrospective report, assessment result, material input or assessment process does not satisfy that scope. The CLEO lifecycle calculation request provides a partial correspondence as a parameter specification. SSbD SpecifiedAssessment denotes a process."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000053 "assessment specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000053 "A plan specification that prescribes how an assessment process is to be conducted in order to achieve a stated assessment objective."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000053 "partial relatedMatch; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000053 <http://purl.obolibrary.org/obo/CLEO_0000007>)
SubClassOf(:MATSUS_0000053 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000054 (assessment output information)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000054 "This information category covers both findings and documents from an assessment. Specified-output provenance requires an explicit process assertion. The SSbD Sign and Data categories do not provide a BFO/IAO category alignment."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000054 "assessment output information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000054 "An information content entity that is produced or compiled as an informational output concerning an assessment process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000054 "loose information-level correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000054 <https://w3id.org/ssbd/Information>)
SubClassOf(:MATSUS_0000054 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000055 (assessment result information)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000055 "This is the common category for qualitative and quantitative findings. A plan, method or report does not become a result by discussing one. The related SSbD Property denotes a semiotic sign, distinct from a BFO quality or a MatSus result."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000055 "assessment result information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000055 "Assessment output information that represents an actual finding or outcome obtained through an assessment process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000055 "loose result-information correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000055 <https://w3id.org/ssbd/Property>)
AnnotationAssertion(:mappedTo :MATSUS_0000055 <https://w3id.org/ssbd/Description>)
SubClassOf(:MATSUS_0000055 :MATSUS_0000054)

# Class: :MATSUS_0000056 (assessment result datum)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000056 "This class inherits IAO data-item semantics for truth-intended information produced by reliable methods, distinct from a process, specification or report. CLEO's result datum is lifecycle-specific and the SSbD datum uses a different upper category. Both correspondences are non-entailing."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000056 "assessment result datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000056 "A data item that is assessment result information and records an actual finding or outcome obtained through an assessment process."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000056 "broader MatSus result-datum correspondence; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000056 <https://w3id.org/ssbd/Datum>)
AnnotationAssertion(:mappedTo :MATSUS_0000056 <http://purl.obolibrary.org/obo/CLEO_0000002>)
SubClassOf(:MATSUS_0000056 <http://purl.obolibrary.org/obo/IAO_0000027>)
SubClassOf(:MATSUS_0000056 :MATSUS_0000055)

# Class: :MATSUS_0000057 (indicator result)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000057 "An indicator result is distinct from its governing metric specification and from the OBI value specification carrying its value. SSbD Indicator denotes an input or property, and CLEO's climate-specific correspondence does not carry its carbon-dioxide-equivalent disposition restriction into MatSus."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000057 "indicator result"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000057 "An assessment result datum that records a quantitative indicator value determined according to a metric specification."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000057 "relatedMatch only; annotation-only; non-entailing")
AnnotationAssertion(:mappedTo :MATSUS_0000057 <https://w3id.org/ssbd/Indicator>)
AnnotationAssertion(:mappedTo :MATSUS_0000057 <http://purl.obolibrary.org/obo/CLEO_0000010>)
SubClassOf(:MATSUS_0000057 ObjectSomeValuesFrom(:MATSUS_0000061 :MATSUS_0000027))
SubClassOf(:MATSUS_0000057 :MATSUS_0000056)

# Class: :MATSUS_0000058 (risk estimate)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000058 "A risk estimate may be qualitative. A quantitative estimate may also be typed as an assessment result datum or indicator result when warranted. No disjointness is asserted. SSbD risk assessments denote processes rather than these findings."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000058 "risk estimate"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000058 "Assessment result information that estimates the likelihood, severity, or level of harm under stated conditions."@en)
SubClassOf(:MATSUS_0000058 :MATSUS_0000055)

# Class: :MATSUS_0000059 (assessment report)

AnnotationAssertion(rdfs:label :MATSUS_0000059 "assessment report"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000059 "A document that organizes or communicates assessment result information concerning one or more assessment processes."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000059 "An assessment report is not identical to an individual result. It may have result information as actual content or be about an external result; those cases require different assertions."@en)
SubClassOf(:MATSUS_0000059 <http://purl.obolibrary.org/obo/IAO_0000310>)
SubClassOf(:MATSUS_0000059 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> :MATSUS_0000043))
SubClassOf(:MATSUS_0000059 :MATSUS_0000054)

# Class: :MATSUS_0000062 (end of use disposition assessment)

AnnotationAssertion(rdfs:label :MATSUS_0000062 "end of use disposition assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000062 "An assessment process that evaluates a material entity to determine the suitability of one or more subsequent end of use management processes."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000062 "Relevant evidence may include condition, functionality, safety, reparability, reusability, remanufacturability, recyclability, composition, or other criteria relevant to selecting a subsequent management pathway."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000062 "The assessment is distinct from the subsequent management process and does not imply that a recommended pathway is selected or executed. Functionality assessments, assays, and other analyses may provide evidence for the assessment."@en)
SubClassOf(:MATSUS_0000062 :MATSUS_0000043)
SubClassOf(:MATSUS_0000062 ObjectSomeValuesFrom(:MATSUS_0000060 <http://purl.obolibrary.org/obo/BFO_0000040>))

# Class: :MATSUS_0000063 (end of use disposition recommendation)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000063 "The ontology asserts no universal is-about existential for a recommendation. For complete records, application-profile validation should check that the recommendation's aboutness target is the material entity evaluated by the associated assessment."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000063 "end of use disposition recommendation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000063 "Assessment result information that recommends one or more end of use management processes for an evaluated material entity."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000063 "A disposition recommendation is distinct from a decision authorizing a pathway and from the subsequent management process itself. It may be supported by other assessment result information concerning condition, functionality, composition, safety, or other relevant characteristics."@en)
SubClassOf(:MATSUS_0000063 :MATSUS_0000055)

# Class: :RecycledContentInformation (recycled content information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :RecycledContentInformation <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :RecycledContentInformation "BatteryPass-ready Data Attribute Long List v1.3, attributes 48-54")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :RecycledContentInformation "This is a calculated composition indicator rather than an intrinsic quality. Circularity and resource-flow assertions require a corresponding process or flow model."@en)
AnnotationAssertion(rdfs:label :RecycledContentInformation "recycled content information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :RecycledContentInformation "A DPP data item that records a calculated share of recycled material content in a battery or constituent material."@en)
SubClassOf(:RecycledContentInformation <http://purl.obolibrary.org/obo/IAO_0000027>)
SubClassOf(:RecycledContentInformation <http://w3id.org/dppo/ontology/dpp-info/DPPInformation>)
SubClassOf(:RecycledContentInformation :MATSUS_0000057)

# Class: :SupplyChainDueDiligenceReport (supply-chain due-diligence report)

AnnotationAssertion(<http://purl.org/dc/terms/source> :SupplyChainDueDiligenceReport <urn:samm:io.BatteryPass.SupplyChainDueDiligence:1.2.0#supplyChainDueDiligenceReport>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :SupplyChainDueDiligenceReport "BatteryPass-ready Data Attribute Long List v1.3, attribute 36")
AnnotationAssertion(rdfs:label :SupplyChainDueDiligenceReport "supply-chain due-diligence report"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :SupplyChainDueDiligenceReport "A document reporting supply-chain due-diligence information for a product or its value chain."@en)
SubClassOf(:SupplyChainDueDiligenceReport <http://purl.obolibrary.org/obo/IAO_0000310>)

# Class: :TestReport (test report)

AnnotationAssertion(<http://purl.org/dc/terms/source> :TestReport <urn:samm:io.BatteryPass.Labels:1.2.0#resultOfTestReport>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :TestReport "BatteryPass-ready Data Attribute Long List v1.3, attribute 27")
AnnotationAssertion(rdfs:label :TestReport "test report"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :TestReport "A document reporting the results of tests used to demonstrate compliance or performance."@en)
SubClassOf(:TestReport <http://purl.obolibrary.org/obo/IAO_0000310>)

# ============================================
# MKB2 SRC-006 LCA architecture, 2026-09-18
# ============================================

Declaration(Class(:MATSUS_0000065))
Declaration(Class(:MATSUS_0000066))
Declaration(Class(:MATSUS_0000067))
Declaration(Class(:MATSUS_0000068))
Declaration(Class(:MATSUS_0000069))
Declaration(Class(:MATSUS_0000070))
Declaration(Class(:MATSUS_0000071))
Declaration(Class(:MATSUS_0000072))
Declaration(Class(:MATSUS_0000073))
Declaration(Class(:MATSUS_0000074))
Declaration(Class(:MATSUS_0000076))
Declaration(ObjectProperty(:MATSUS_0000077))
Declaration(NamedIndividual(:MATSUS_0000078))
Declaration(NamedIndividual(:MATSUS_0000079))

# Class: :MATSUS_0000065 (life cycle assessment process)

AnnotationAssertion(rdfs:label :MATSUS_0000065 "life cycle assessment process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000065 "A sustainability assessment that compiles and evaluates inputs, outputs, and potential environmental impacts associated with a product system across its life cycle."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000065 "Life cycle inventory analysis and life cycle impact assessment are represented as process parts of a life cycle assessment, not as subclasses of it. No universal specified-output restriction is asserted."@en)
SubClassOf(:MATSUS_0000065 :MATSUS_0000048)
SubClassOf(:MATSUS_0000065 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000066))
SubClassOf(:MATSUS_0000065 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000067))
SubClassOf(:MATSUS_0000065 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000293> :MATSUS_0000072))

# Class: :MATSUS_0000066 (life cycle inventory analysis process)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000066 "Inventory analysis is a planned process for compiling inputs and outputs. It may occur as part of a life cycle assessment without itself being classified as an assessment process."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000066 "life cycle inventory analysis process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000066 "A planned process that compiles and quantifies inputs and outputs relevant to a life cycle assessment."@en)
SubClassOf(:MATSUS_0000066 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000067 (life cycle impact assessment process)

AnnotationAssertion(rdfs:label :MATSUS_0000067 "life cycle impact assessment process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000067 "A sustainability assessment that evaluates potential environmental impacts using life cycle inventory information and impact categories."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000067 "This class is parallel to life cycle assessment under sustainability assessment and may occur as a process part of a life cycle assessment."@en)
SubClassOf(:MATSUS_0000067 :MATSUS_0000048)

# Class: :MATSUS_0000068 (life cycle assessment specification)

AnnotationAssertion(rdfs:label :MATSUS_0000068 "life cycle assessment specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000068 "An assessment specification that prescribes the scope, reference basis, system boundary, and other methodological choices for a life cycle assessment process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000068 "Functional unit, reference flow, and system boundary specifications are represented as information parts of the life cycle assessment specification."@en)
SubClassOf(:MATSUS_0000068 :MATSUS_0000053)
SubClassOf(:MATSUS_0000068 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000069))
SubClassOf(:MATSUS_0000068 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000070))
SubClassOf(:MATSUS_0000068 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000071))

# Class: :MATSUS_0000069 (functional unit specification)

AnnotationAssertion(rdfs:label :MATSUS_0000069 "functional unit specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000069 "A directive information entity that specifies a quantified performance used as the reference basis of a life cycle assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000069 "This is information specifying the reference basis of the assessment, not a physical unit and not the assessed process itself."@en)
SubClassOf(:MATSUS_0000069 <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: :MATSUS_0000070 (reference flow specification)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000070 "This information content entity specifies a reference flow. The ontology does not commit to a narrower directive-information subtype."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000070 "reference flow specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000070 "An information content entity that specifies the quantity of product or material flow required to fulfil the functional unit of a life cycle assessment."@en)
SubClassOf(:MATSUS_0000070 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000071 (system boundary specification)

AnnotationAssertion(rdfs:label :MATSUS_0000071 "system boundary specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000071 "A directive information entity that specifies which processes or activities are included in or excluded from the system evaluated by a life cycle assessment."@en)
SubClassOf(:MATSUS_0000071 <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: :MATSUS_0000072 (system model)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000072 "This information class models systems generically, including in lifecycle contexts. No separate lifecycle-system-model subclass is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000072 "system model"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000072 "An information content entity that represents processes, flows, and relationships of a system for assessment or analysis."@en)
SubClassOf(:MATSUS_0000072 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000073 (impact category)

AnnotationAssertion(rdfs:label :MATSUS_0000073 "impact category"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000073 "An information content entity that represents an environmental issue of concern evaluated in a life cycle impact assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000073 "An impact category is information used to organize and interpret impact assessment; it is not itself an assessment process or environmental effect."@en)
SubClassOf(:MATSUS_0000073 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000074 (life cycle assessment result information)

AnnotationAssertion(rdfs:label :MATSUS_0000074 "life cycle assessment result information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000074 "Assessment result information that represents a finding or outcome obtained through a life cycle assessment process."@en)
SubClassOf(:MATSUS_0000074 :MATSUS_0000055)

AnnotationAssertion(rdfs:label :MATSUS_0000076 "carbon footprint result"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000076 "carbon footprint"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000076 "An indicator result that quantifies greenhouse gas emissions and removals associated with a specified subject and scope as carbon dioxide equivalents for the climate-change impact category."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000076 "The applicable scope, method, global-warming-potential time horizon, and completeness depend on the governing specification. Membership in this class does not by itself imply a complete life cycle assessment or conformity with a particular standard."@en)
SubClassOf(:MATSUS_0000076 :MATSUS_0000057)

# Object Property: :MATSUS_0000077 (contributes to)

AnnotationAssertion(rdfs:label :MATSUS_0000077 "contributes to"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000077 "Relates assessment result information to other assessment result information to whose represented result it contributes."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000077 "This relation does not assert parthood, arithmetic summation, exhaustive coverage, or transitivity."@en)
ObjectPropertyDomain(:MATSUS_0000077 :MATSUS_0000055)
ObjectPropertyRange(:MATSUS_0000077 :MATSUS_0000055)

# Named Individual: :MATSUS_0000078 (climate change)

AnnotationAssertion(rdfs:label :MATSUS_0000078 "climate change"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000078 "An impact category concerning potential effects associated with changes in the climate system."@en)
ClassAssertion(:MATSUS_0000073 :MATSUS_0000078)

# Named Individual: :MATSUS_0000079 (GWP100)

AnnotationAssertion(rdfs:label :MATSUS_0000079 "GWP100"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000079 "A metric specification for global warming potential evaluated over a 100-year time horizon."@en)
ClassAssertion(:MATSUS_0000027 :MATSUS_0000079)
ObjectPropertyAssertion(<http://purl.obolibrary.org/obo/IAO_0000136> :MATSUS_0000079 :MATSUS_0000078)

# ============================================
# MKB2 SRC-007 MATERIAL EFFICIENCY INCREMENT
# ============================================

Declaration(Class(:MATSUS_0000080))
Declaration(Class(:MATSUS_0000081))

# Class: :MATSUS_0000080 (durability)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000080 "Durability here is a generic disposition of a material entity. PMDco PMD_0080133 has the narrower meaning of resistance to wear, tear and damage and sits under PMDco's unclassified property branch. No equivalence or subclass relationship is asserted."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000080 "material entity durability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000080 "durability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000080 "A disposition of a material entity to retain specified properties or performance over time under stated conditions."@en)
SubClassOf(:MATSUS_0000080 <http://purl.obolibrary.org/obo/BFO_0000016>)

# Class: :MATSUS_0000081 (recycled content datum)

AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000081 "This general datum is separate from the battery-specific RecycledContentInformation class. It has no asserted indicator-result or DPPInformation superclass."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000081 "recycled content datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000081 "A data item that records the proportion of recycled material in a specified material entity."@en)
SubClassOf(:MATSUS_0000081 <http://purl.obolibrary.org/obo/IAO_0000027>)

# MKB2 SRC-007/008 - approved integration candidates
Declaration(Class(<http://purl.obolibrary.org/obo/IAO_0000030>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#example>))

Declaration(Class(:MATSUS_0000082))
# Class: :MATSUS_0000082 (critical raw material role)
AnnotationAssertion(rdfs:label :MATSUS_0000082 "critical raw material role"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000082 "A role borne by a material entity when its raw-material category is officially designated as critical by a competent public authority within a specified regulatory context."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000082 "A cobalt feedstock batch bearing a CRM role under an applicable EU designation."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000082 "CRM status is contextual, not an intrinsic quality. EU reference: Regulation (EU) 2024/1252, Article 4 and Annex II, as amended. Eligible bearers may include portions of matter, objects and aggregates, but mere containment of a critical raw material does not establish this role. The designation-to-bearer linkage requires contextual evidence."@en)
SubClassOf(:MATSUS_0000082 <http://purl.obolibrary.org/obo/BFO_0000023>)

Declaration(Class(:MATSUS_0000083))
# Class: :MATSUS_0000083 (critical raw material designation)
AnnotationAssertion(rdfs:label :MATSUS_0000083 "critical raw material designation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000083 "An information content entity that officially designates a raw-material category as critical under a specified regulatory framework."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000083 "An official EU designation of a raw-material category as critical under a particular version of Annex II."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000083 "Record the authority, jurisdiction, legal basis, applicable material category and temporal validity. This is not the physical material, CRM role, or technical criticality assessment result. No separate designation-list class is introduced."@en)
SubClassOf(:MATSUS_0000083 <http://purl.obolibrary.org/obo/IAO_0000030>)

Declaration(Class(:MATSUS_0000084))
# Class: :MATSUS_0000084 (repairability)
AnnotationAssertion(rdfs:label :MATSUS_0000084 "repairability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000084 "A disposition of a material entity to have its impaired functionality restored through repair under specified conditions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000084 "A gearbox that can have a defective bearing replaced to restore its intended function."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000084 "Typical bearers are objects and aggregates. Repair may require spare parts, tools and expertise. Repairability is distinct from assignment to a repair program and from a repairability assessment result."@en)
SubClassOf(:MATSUS_0000084 <http://purl.obolibrary.org/obo/BFO_0000016>)

Declaration(Class(:MATSUS_0000085))
# Class: :MATSUS_0000085 (maintainability)
AnnotationAssertion(rdfs:label :MATSUS_0000085 "maintainability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000085 "A disposition of a material entity to have its required functionality or condition sustained or restored through maintenance under specified conditions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000085 "An industrial drive assembly designed for accessible inspection, lubrication and maintenance."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000085 "Typical bearers are functional objects and assemblies. Maintenance may be preventive or corrective. Maintainability is distinct from repairability; neither is asserted as a subclass of the other."@en)
SubClassOf(:MATSUS_0000085 <http://purl.obolibrary.org/obo/BFO_0000016>)

Declaration(Class(:MATSUS_0000086))
# Class: :MATSUS_0000086 (reusability)
AnnotationAssertion(rdfs:label :MATSUS_0000086 "reusability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000086 "A disposition of a material entity to be used again for a specified purpose without material reprocessing under stated conditions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000086 "A recovered component suitable for further use after inspection."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000086 "Bearers may include objects, aggregates and portions of matter. Distinguish capability from actual reuse and designation for reuse. EU Waste Framework Directive reuse terminology is narrower, focusing on non-waste products or components reused for the same purpose."@en)
SubClassOf(:MATSUS_0000086 <http://purl.obolibrary.org/obo/BFO_0000016>)

Declaration(Class(:MATSUS_0000087))
# Class: :MATSUS_0000087 (remanufacturability)
AnnotationAssertion(rdfs:label :MATSUS_0000087 "remanufacturability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000087 "A disposition of a used material entity to undergo reprocessing that produces a product meeting equivalent-new performance and quality requirements under specified conditions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000087 "A used industrial component suitable for remanufacturing to equivalent-new requirements."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000087 "Interpret consistently with MatSus remanufacturing process MATSUS_0000036. Do not assert equivalence with the distinct remanufacturing definition in Regulation (EU) 2024/1781. Typical bearers are used products and components."@en)
SubClassOf(:MATSUS_0000087 <http://purl.obolibrary.org/obo/BFO_0000016>)

Declaration(Class(:MATSUS_0000088))
# Class: :MATSUS_0000088 (expected lifetime datum)
AnnotationAssertion(rdfs:label :MATSUS_0000088 "expected lifetime datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000088 "A data item that records an estimate of the duration for which a material entity will satisfy specified functional or performance requirements under stated use conditions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000088 "An estimated 12-year service life of a gearbox under a defined operating and maintenance profile."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000088 "Distinguish expected lifetime from observed service life, warranty, guarantee and the durability disposition. Record assumptions, method, units and uncertainty. It may be an LCA input assumption or an assessment result, but is not universally an indicator result."@en)
SubClassOf(:MATSUS_0000088 <http://purl.obolibrary.org/obo/IAO_0000027>)

Declaration(Class(:MATSUS_0000089))
# Class: :MATSUS_0000089 (actual service life datum)
AnnotationAssertion(rdfs:label :MATSUS_0000089 "actual service life datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000089 "A data item that records the observed duration of service of a material entity between specified lifecycle events."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000089 "A recorded nine-year service period between commissioning and retirement of a component."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000089 "Distinguish observed service duration from estimated lifetime. Record start and end events and any interruption or uncertainty. Ongoing service records require explicit treatment of the observation endpoint; do not imply final retirement."@en)
SubClassOf(:MATSUS_0000089 <http://purl.obolibrary.org/obo/IAO_0000027>)

# ============================================
# MKB2 LIFE CYCLE COSTING INCREMENT
# ============================================

Declaration(Class(:MATSUS_0000090))
Declaration(Class(:MATSUS_0000091))
Declaration(Class(:MATSUS_0000092))

# Class: :MATSUS_0000090 (life cycle costing assessment)

AnnotationAssertion(rdfs:label :MATSUS_0000090 "life cycle costing assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000090 "An assessment process that evaluates monetary costs and, where applicable, revenues, benefits or monetized externalities associated with an entity or system over a specified portion of its life cycle from a stated perspective."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000090 "An assessment comparing the discounted acquisition, manufacturing, operation, maintenance, and end-of-life costs of functionally equivalent product systems using virgin aluminium and recycled aluminium over 20 years from the manufacturer's perspective."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000090 "Conventional, environmental, and societal life cycle costing are distinguished by the scope and perspective prescribed by the governing specification. This class is not a subclass of economic sustainability assessment (MATSUS_0000050), because conventional life cycle costing need not evaluate economic sustainability. A life cycle costing assessment instance used for sustainability evaluation may additionally be typed as MATSUS_0000050. This class is distinct from life cycle assessment process (MATSUS_0000065)."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000090 <https://eur-lex.europa.eu/eli/reco/2026/510/oj/eng>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000090 <https://doi.org/10.2760/5103785>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000090 <https://doi.org/10.1201/9781420054736>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000090 <https://www.setac.org/resource/enviro-life-cycle-costing-code-practice.html>)
SubClassOf(:MATSUS_0000090 :MATSUS_0000043)

# Class: :MATSUS_0000091 (life cycle costing specification)

AnnotationAssertion(rdfs:label :MATSUS_0000091 "life cycle costing specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000091 "An assessment specification that prescribes the methodological scope, perspective, temporal and monetary assumptions, and calculation rules for a life cycle costing assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000091 "A specification for comparing virgin- and recycled-aluminium routes that states one tonne of conforming sheet as the functional reference, cradle-to-grave boundaries, a 20-year horizon, EUR with 2025 as the reference year, a 3 percent discount rate, the cost bearers and cost categories, and whether externalities are monetized."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000091 "Relevant parameters include the costing variant, cost bearers, functional reference, lifecycle boundaries, time horizon, currency, reference year, discounting, cost categories, and externality treatment. These are information-level or application-profile parameters without mandatory OWL restrictions. The scope is distinct from life cycle assessment specification (MATSUS_0000068). No generic relation from an assessment process to its governing specification is asserted."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000091 <https://doi.org/10.1201/9781420054736>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000091 <https://www.setac.org/resource/enviro-life-cycle-costing-code-practice.html>)
SubClassOf(:MATSUS_0000091 :MATSUS_0000053)

# Class: :MATSUS_0000092 (life cycle cost result)

AnnotationAssertion(rdfs:label :MATSUS_0000092 "life cycle cost result"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000092 "An indicator result that records a monetary cost amount, including an aggregate, component or net cost, determined through a life cycle costing assessment according to a metric specification."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000092 "A discounted total life cycle cost of EUR 2.4 million in 2025 euros per 10,000 components for the recycled-material route over a 20-year horizon."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000092 "Cost results are distinct from revenues and benefits, which can be recorded separately as indicator results unless the governing metric specification calculates a net cost. A monetized externality is a cost result only when the costing method treats it as a monetary cost. The underlying physical impact remains distinct. This class inherits the indicator-specification pattern. Currency and monetary-value encoding are not fixed by the class."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000092 <https://doi.org/10.1201/9781420054736>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000092 <https://www.setac.org/resource/enviro-life-cycle-costing-code-practice.html>)
SubClassOf(:MATSUS_0000092 :MATSUS_0000057)

# ============================================
# RECYCLING PROCESS VOCABULARY INCREMENT
# ============================================

Declaration(Class(:MATSUS_0000093))

# Class: :MATSUS_0000093 (shredding process)

AnnotationAssertion(rdfs:label :MATSUS_0000093 "shredding process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000093 "A dividing process in which solid material is mechanically cut, torn, or broken into smaller pieces."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000093 "PMDco dividing includes mechanical shear cutting, splitting, tearing and breaking, so shredding specializes that process without being equivalent to dividing or separating. No sorting, stream-separation, recycling-context or product-shape restriction is asserted."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000093 <https://www.basel.int/Portals/4/download.aspx?d=UNEP-CHW-WAST-GUID-ESM-PlasticWastes-20230512.English.pdf>)
SubClassOf(:MATSUS_0000093 <https://w3id.org/pmd/co/PMD_0000614>)

Declaration(Class(:MATSUS_0000094))

# Class: :MATSUS_0000094 (melt filtration process)

AnnotationAssertion(rdfs:label :MATSUS_0000094 "melt filtration process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000094 "A filtration process in which solid particulate contaminants are separated from a flowing molten material by means of a filter device."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000094 "Melt filtration specializes OBI filtration because the filter separates particles from a fluid melt. It remains distinct from extrusion, even within an integrated operation. No equivalence or restriction to polymers, recycling, filter geometry, or a particular manufacturing operation is asserted."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000094 <http://purl.obolibrary.org/obo/OBI_0302885>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000094 <https://www.basel.int/Portals/4/download.aspx?d=UNEP-CHW.16-CRP.31.English.pdf>)
SubClassOf(:MATSUS_0000094 <http://purl.obolibrary.org/obo/OBI_0302885>)

Declaration(Class(:MATSUS_0000095))

# Class: :MATSUS_0000095 (drying process)

AnnotationAssertion(rdfs:label :MATSUS_0000095 "drying process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000095 "A material component separation process in which the liquid content of a material is reduced by removing water or another liquid."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000095 "Drying specializes material component separation by reducing a material's liquid content. FoodOn drying (FOODON_03000614, release 2026-09-20) provides conceptual inspiration without an import, equivalence, or mapping. The class is not restricted to food, polymers, recycling, or a particular drying mechanism."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000095 <http://purl.obolibrary.org/obo/FOODON_03000614>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000095 <http://purl.obolibrary.org/obo/foodon/releases/2026-09-20/foodon.owl>)
SubClassOf(:MATSUS_0000095 <http://purl.obolibrary.org/obo/OBI_0600014>)

Declaration(Class(:MATSUS_0000096))

# Class: :MATSUS_0000096 (pelletizing process)

AnnotationAssertion(rdfs:label :MATSUS_0000096 "pelletizing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000096 "A manufacturing process in which material is formed into discrete pellets."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> :MATSUS_0000096 "Methods may include strand pelletizing, die-face pelletizing, compaction, or agglomeration, depending on the material and application."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000096 "The manufacturing-process parent accommodates different pellet-formation mechanisms, which need not involve dividing. The class is not restricted to polymers, recycling, a particular method, or machinery. Regranulation is not an alternative label or equivalent class because its process boundary has not been established."@en)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000096 <https://www.basel.int/Portals/4/download.aspx?d=UNEP-CHW-WAST-GUID-ESM-PlasticWastes-20230512.English.pdf>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000096 <https://publications.jrc.ec.europa.eu/repository/bitstream/JRC91637/2014-jrc91637%20.pdf>)
SubClassOf(:MATSUS_0000096 <https://w3id.org/pmd/co/PMD_0000833>)

)
