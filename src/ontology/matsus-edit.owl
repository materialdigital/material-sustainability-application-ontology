# Class: :MATSUS_0000001 (recovered material)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000001 "MKB1 IR2 Class Review: POST-MKB1-MAT-001 / MKB-000175 supporting anchor")
AnnotationAssertion(rdfs:label :MATSUS_0000001 "recovered material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000001 "A material obtained through a material-recovery process from material that had been discarded, become waste, or left its preceding use, and that is made available for further use."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000001 "Post-gate accepted material anchor. A material can cease to bear a waste role while retaining its recovery provenance. Later: link the material to its recovery process/history. Do not add disjointness or a complement axiom.")
AnnotationAssertion(:integrationMethod :MATSUS_0000001 "new MatSus subclass of PMDco material")
SubClassOf(:MATSUS_0000001 <https://w3id.org/pmd/co/PMD_0000000>)

# Class: :MATSUS_0000002 (recycled material)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000002 "MKB1 IR2 Class Review: MKB-000175")
AnnotationAssertion(rdfs:label :MATSUS_0000002 "recycled material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000002 "A recovered material produced through a recycling process in which waste material is reprocessed into a product, material, or substance for its original or another purpose."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000002 "Post-gate accepted. Recycled material and secondary material are not exclusive categories. Later: link to the recycling process/history. Do not assert disjointness from secondary material.")
AnnotationAssertion(:integrationMethod :MATSUS_0000002 "new MatSus subclass of recovered material")
SubClassOf(:MATSUS_0000002 :MATSUS_0000001)

# Class: :MATSUS_0000003 (secondary material)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000003 "MKB1 IR2 Class Review: MKB-000223")
AnnotationAssertion(rdfs:label :MATSUS_0000003 "secondary material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000003 "A recovered material suitable for use in manufacturing or material processing instead of or alongside virgin material."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000003 "Post-gate accepted as a positive material category rather than a complement of virgin material. Later: represent suitability or intended use only when a stable relation pattern is selected. Do not assert disjointness from recycled material.")
AnnotationAssertion(:integrationMethod :MATSUS_0000003 "new MatSus subclass of recovered material")
SubClassOf(:MATSUS_0000003 :MATSUS_0000001)

# Class: :MATSUS_0000004 (material sustainability assessment)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000004 "MKB1 IR2 Class Review: POST-MKB1-ASS-001 / MKB-000180 supporting anchor")
AnnotationAssertion(rdfs:label :MATSUS_0000004 "material sustainability assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000004 "An assay intended to produce information for evaluating one or more sustainability-related aspects of a material, product, process, or material lifecycle system."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000004 "Post-gate accepted provisionally as the parent needed for resource-input reduction assessment. Later: reconcile the assessment umbrella during the later SRC-007/SRC-009/CLEO assessment reconciliation in MKB source Batch 2; add no further logical restrictions now.")
AnnotationAssertion(:integrationMethod :MATSUS_0000004 "new MatSus subclass of OBI assay")
SubClassOf(:MATSUS_0000004 <http://purl.obolibrary.org/obo/OBI_0000070>)

# Class: :MATSUS_0000005 (resource-input reduction assessment)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000005 "MKB1 IR2 Class Review: MKB-000180-ASS")
AnnotationAssertion(rdfs:label :MATSUS_0000005 "resource-input reduction assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000005 "A material sustainability assessment intended to determine or quantify whether, and to what extent, material input has been reduced relative to a stated baseline under specified comparison conditions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000005 "Post-gate accepted. Keep assessment distinct from the process and its objective specification. Later: model the evaluated process or system, baseline, comparison conditions and output datum.")
AnnotationAssertion(:integrationMethod :MATSUS_0000005 "new MatSus subclass of material sustainability assessment")
SubClassOf(:MATSUS_0000005 :MATSUS_0000004)

# Class: :MATSUS_0000006 (resource-input reduction objective specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000006 "MKB1 IR2 Class Review: MKB-000180-OBJ")
AnnotationAssertion(rdfs:label :MATSUS_0000006 "resource-input reduction objective specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000006 "An objective specification that specifies an intended reduction, relative to a stated baseline and under specified comparison conditions, in the quantity of material input required or used by a specified process or system."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000006 "Example: reduce virgin aluminium input by 20% relative to the 2025 baseline. Later: relate the objective specification to the targeted process or system, baseline, reduction amount and unit. No separate resource-input reduction strategy specification is required.")
AnnotationAssertion(:integrationMethod :MATSUS_0000006 "new MatSus subclass of IAO objective specification")
SubClassOf(:MATSUS_0000006 <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: :MATSUS_0000007 (waste role)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000007 "MKB1 IR2 Class Review: supporting waste anchor; human-gate Closure; PMDco issue #485")
AnnotationAssertion(rdfs:label :MATSUS_0000007 "waste role"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000007 "A role borne by a material entity when its holder discards it, intends to discard it, or is required to discard it."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000007 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Waste status is contextual and role-based, not an intrinsic material kind. Later: decide realization and context relations and the future PMDco mapping. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000007 "new MatSus subclass of BFO role")
SubClassOf(:MATSUS_0000007 <http://purl.obolibrary.org/obo/BFO_0000023>)

# Class: :MATSUS_0000008 (waste material)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000008 "MKB1 IR2 Class Review: supporting waste anchor; human-gate Closure; PMDco issue #485")
AnnotationAssertion(rdfs:label :MATSUS_0000008 "waste material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000008 "waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000008 "A material that bears a waste role."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000008 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Waste is an alternative label. The has role restriction is necessary only; do not assert equivalence. Do not make recovered material a subclass of waste material. Later: select a temporal or contextual model for acquiring and losing the role. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000008 "new MatSus subclass of PMDco material with a necessary waste-role restriction")
SubClassOf(:MATSUS_0000008 <https://w3id.org/pmd/co/PMD_0000000>)
SubClassOf(:MATSUS_0000008 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> :MATSUS_0000007))

# Class: :MATSUS_0000009 (construction and demolition waste)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000009 "MKB1 IR2 Class Review: MKB-000063; SRC-001 Circular Berlin; Master Analysis row 52")
AnnotationAssertion(rdfs:label :MATSUS_0000009 "construction and demolition waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000009 "A waste material that arises from construction or demolition activities."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000009 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Retain this local subtype after any upstream anchor migration. Later: add source or provenance criteria only if required by data integration. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000009 "new MatSus subclass of waste material")
SubClassOf(:MATSUS_0000009 :MATSUS_0000008)

# Class: :MATSUS_0000010 (mineral waste)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000010 "MKB1 IR2 Class Review: MKB-000144; SRC-003 European Environment Agency; Master Analysis row 69")
AnnotationAssertion(rdfs:label :MATSUS_0000010 "mineral waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000010 "A waste material composed predominantly of mineral matter."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000010 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Predominantly is intentionally not assigned an OWL cutoff. Later: represent thresholds through data or a classification specification. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000010 "new MatSus subclass of waste material")
SubClassOf(:MATSUS_0000010 :MATSUS_0000008)

# Class: :MATSUS_0000011 (municipal waste)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000011 "MKB1 IR2 Class Review: MKB-000148; SRC-003 European Environment Agency; Master Analysis row 71")
AnnotationAssertion(rdfs:label :MATSUS_0000011 "municipal waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000011 "municipal solid waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000011 "A waste material collected from households or a waste material from another source that is similar in nature and composition to household waste."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000011 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Municipal solid waste is an alternative label, not an equivalent class. Later: assert equivalence only if the scopes are confirmed identical. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000011 "new MatSus subclass of waste material")
SubClassOf(:MATSUS_0000011 :MATSUS_0000008)

# Class: :MATSUS_0000012 (packaging waste)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000012 "MKB1 IR2 Class Review: MKB-000155; SRC-003 European Environment Agency; Master Analysis row 74; TransformON exact-label evidence insufficient for reuse")
AnnotationAssertion(rdfs:label :MATSUS_0000012 "packaging waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000012 "A waste material that was packaging or packaging material before it acquired a waste role."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000012 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. The selected source scope excludes production residues. Later: represent former packaging status and the exclusion only with a validated pattern. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000012 "new MatSus subclass of waste material")
SubClassOf(:MATSUS_0000012 :MATSUS_0000008)

# Class: :MATSUS_0000013 (textile waste)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000013 "MKB1 IR2 Class Review: MKB-000249; SRC-001 Circular Berlin; Master Analysis row 111")
AnnotationAssertion(rdfs:label :MATSUS_0000013 "textile waste"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000013 "A waste material composed predominantly of textile material or discarded textile products."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000013 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. This is intentionally a broad provisional subtype. Later: add fibre, composition, or product-type refinements only from concrete use cases. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000013 "new MatSus subclass of waste material")
SubClassOf(:MATSUS_0000013 :MATSUS_0000008)

# Class: :MATSUS_0000014 (collection system)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000014 "MKB1 IR2 Class Review: MKB-000059")
AnnotationAssertion(rdfs:label :MATSUS_0000014 "collection system"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000014 "An object aggregate whose members are organized to enable one or more collection processes."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000014 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. The object-aggregate parent is provisional. Later: model members or components, enabling function, responsible agent, and collection processes when those queries become central. Do not introduce a universal generic system class. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000014 "new MatSus subclass of BFO object aggregate")
SubClassOf(:MATSUS_0000014 <http://purl.obolibrary.org/obo/BFO_0000027>)

# Class: :MATSUS_0000015 (waste collection process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000015 "MKB1 IR2 Class Review: supporting waste process; human-gate Closure related-terms decision")
AnnotationAssertion(rdfs:label :MATSUS_0000015 "waste collection process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000015 "A planned process in which waste material is gathered from one or more holders or locations for transport, storage, sorting, recovery, treatment, or disposal."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000015 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. This is a supporting process with no standalone MKB ID. Later: add waste participant, origin, destination, and responsible-agent relations. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000015 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000015 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000016 (sorting process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000016 "MKB1 IR2 Class Review: MKB-000231; SRC-001 Circular Berlin; Master Analysis row 106")
AnnotationAssertion(rdfs:label :MATSUS_0000016 "sorting process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000016 "A planned process in which material entities are assigned to different groups or streams according to specified criteria."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000016 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. No acceptable maintained equivalent was found. Later: connect criteria or method specifications and sorted inputs and outputs. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000016 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000016 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000017 (sorting method specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000017 "MKB1 IR2 Class Review: MKB-000231; SRC-001 Circular Berlin; Master Analysis row 106")
AnnotationAssertion(rdfs:label :MATSUS_0000017 "sorting method specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000017 "A plan specification that prescribes how a sorting process is to be carried out."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000017 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. This is an information content entity and is not a subclass of sorting process. Later: relate the method specification to the sorting process it prescribes. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000017 "new MatSus subclass of IAO plan specification")
SubClassOf(:MATSUS_0000017 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000018 (waste separation process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000018 "MKB1 IR2 Class Review: supporting waste process; human-gate Closure related-terms decision")
AnnotationAssertion(rdfs:label :MATSUS_0000018 "waste separation process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000018 "A sorting process in which waste material is assigned to different groups or streams according to specified criteria."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000018 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. This is a supporting process with no standalone MKB ID. Later: add waste input and separated-stream output restrictions after example testing. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000018 "new MatSus subclass of sorting process")
SubClassOf(:MATSUS_0000018 :MATSUS_0000016)

# Class: :MATSUS_0000019 (waste generation process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000019 "MKB1 IR2 Class Review: MKB-000263; SRC-003 European Environment Agency; Master Analysis row 115")
AnnotationAssertion(rdfs:label :MATSUS_0000019 "waste generation process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000019 "A process that has as output a material entity that bears a waste role."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000019 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Waste generation is not assumed to be planned production or synthesis. Later: distinguish planned and unplanned generation through context unless required otherwise. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000019 "new MatSus subclass of BFO process with a necessary waste-material output restriction")
SubClassOf(:MATSUS_0000019 <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(:MATSUS_0000019 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> :MATSUS_0000008))

# Class: :MATSUS_0000020 (waste prevention process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000020 "MKB1 IR2 Class Review: MKB-000264; SRC-001 Circular Berlin; SRC-003 European Environment Agency; Master Analysis row 116")
AnnotationAssertion(rdfs:label :MATSUS_0000020 "waste prevention process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000020 "A planned process that is intended to reduce the quantity or harmfulness of waste generated, or the adverse impacts of generated waste on the environment and human health."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000020 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Keep the performed process distinct from its measure specification. Later: relate the process to targeted streams and prevention outcomes. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000020 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000020 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000021 (waste prevention measure specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000021 "MKB1 IR2 Class Review: MKB-000264; SRC-001 Circular Berlin; SRC-003 European Environment Agency; Master Analysis row 116")
AnnotationAssertion(rdfs:label :MATSUS_0000021 "waste prevention measure specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000021 "A plan specification that prescribes actions intended to realize a waste prevention process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000021 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. This is an information artifact, not a process. Later: connect it to the prescribed process. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000021 "new MatSus subclass of IAO plan specification")
SubClassOf(:MATSUS_0000021 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000022 (zero-waste objective specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000022 "MKB1 IR2 Class Review: MKB-000266; SRC-001 Circular Berlin; Master Analysis row 117")
AnnotationAssertion(rdfs:label :MATSUS_0000022 "zero-waste objective specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000022 "An objective specification that describes an intended endpoint in which waste generation and disposal are prevented or minimized through responsible production, consumption, reuse, and recovery."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000022 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Zero waste is normative information content, not a material or process. Later: represent scope, baseline, and tolerated residual waste if needed. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000022 "new MatSus subclass of IAO objective specification")
SubClassOf(:MATSUS_0000022 <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: :MATSUS_0000023 (zero-waste strategy specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000023 "MKB1 IR2 Class Review: MKB-000266; SRC-001 Circular Berlin; Master Analysis row 117")
AnnotationAssertion(rdfs:label :MATSUS_0000023 "zero-waste strategy specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000023 "A plan specification that prescribes actions intended to achieve a zero-waste objective."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000023 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Keep the strategy distinct from its objective. Later: relate it to the objective and prescribed prevention, reuse, and recovery processes. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000023 "new MatSus subclass of IAO plan specification")
SubClassOf(:MATSUS_0000023 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000024 (waste elimination objective specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000024 "MKB1 IR2 Class Review: MKB-000085; SRC-002 Ellen MacArthur Foundation; Master Analysis row 56")
AnnotationAssertion(rdfs:label :MATSUS_0000024 "waste elimination objective specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000024 "An objective specification that specifies the intended absence of a specified waste output within a stated scope."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000024 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. MKB-000085 is retained as provenance. Do not create an undefined generic elimination process. Later: link to a scoped waste target and boundary. Pollution-elimination modelling is deferred until a suitable pollution target pattern is established. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000024 "new MatSus subclass of IAO objective specification")
SubClassOf(:MATSUS_0000024 <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: :MATSUS_0000025 (waste analysis)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000025 "MKB1 IR2 Class Review: MKB-000236; SRC-001 Circular Berlin; Master Analysis row 107")
AnnotationAssertion(rdfs:label :MATSUS_0000025 "waste analysis"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000025 "An assay intended to produce information about waste material, a waste-generating process, or a waste stream."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000025 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Analysis is an assay, not the information output itself. Later: add evaluant, method, and output-datum relations using a concrete example. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000025 "new MatSus subclass of OBI assay")
SubClassOf(:MATSUS_0000025 <http://purl.obolibrary.org/obo/OBI_0000070>)

# Class: :MATSUS_0000026 (structural waste analysis)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000026 "MKB1 IR2 Class Review: MKB-000236; SRC-001 Circular Berlin; Master Analysis row 107")
AnnotationAssertion(rdfs:label :MATSUS_0000026 "structural waste analysis"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000026 "A waste analysis intended to produce information about the composition, organization, or distribution of material constituents within a waste material or waste stream."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000026 "Human-gate-authorized provisional MKB1 IR2 waste implementation. PMDco issue #485 is ISSUE_SUBMITTED. Recurring-generation-pattern analysis is outside this definition. Later: consider recurring-source analysis as a sibling class. Later PMDco acceptance triggers migration or reconciliation of mappings, parents, and restrictions, not deletion of the MatSus specialization.")
AnnotationAssertion(:integrationMethod :MATSUS_0000026 "new MatSus subclass of waste analysis")
SubClassOf(:MATSUS_0000026 :MATSUS_0000025)

# Class: :MATSUS_0000027 (metric specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000027 "MKB1 IR2 Class Review: ADD-SCO-012; SCO")
AnnotationAssertion(rdfs:label :MATSUS_0000027 "metric specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000027 "A directive information entity that prescribes the quantities, calculation method, units, boundary, and interpretation used to produce a quantitative indicator datum."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000027 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. Metric specifications prescribe methods; resulting metric values remain data items. Later: relate prescribed quantities, calculation method, units, boundary, interpretation, and resulting datum. No further logical restrictions are asserted in this batch.")
AnnotationAssertion(:integrationMethod :MATSUS_0000027 "new MatSus subclass of IAO directive information entity")
SubClassOf(:MATSUS_0000027 <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: :MATSUS_0000028 (resource efficiency datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000028 "MKB1 IR2 Class Review: MKB-000205; SRC-001 Circular Berlin; UNEP domain meaning")
AnnotationAssertion(rdfs:label :MATSUS_0000028 "resource efficiency datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000028 "A data item that records the useful output, service, or value obtained per stated quantity of resource input under a specified method, boundary, and time interval."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000028 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. This is a calculated result datum, not an intrinsic efficiency quality. Later: model numerator or output, resource input, method, boundary, unit, time interval, and calculation relations.")
AnnotationAssertion(:integrationMethod :MATSUS_0000028 "new MatSus subclass of IAO data item")
SubClassOf(:MATSUS_0000028 <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: :MATSUS_0000029 (material resource efficiency datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000029 "MKB1 IR2 Class Review: MKB-000137; SRC-003 European Environment Agency")
AnnotationAssertion(rdfs:label :MATSUS_0000029 "material resource efficiency datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000029 "A resource efficiency datum whose stated resource input is a quantity of material."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000029 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. This is the material-input specialization of resource efficiency datum. Later: constrain the stated resource input to a material quantity and add method, unit, or boundary relations only through an approved pattern.")
AnnotationAssertion(:integrationMethod :MATSUS_0000029 "new MatSus subclass of resource efficiency datum")
SubClassOf(:MATSUS_0000029 :MATSUS_0000028)

# Class: :MATSUS_0000030 (virgin material)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000030 "MKB1 IR2 Class Review: MKB-000150; SRC-002 Ellen MacArthur Foundation; ISO 21067-2:2015 terminology as reproduced in the ISO/DIS 15270-1 plastics-recovery draft")
AnnotationAssertion(rdfs:label :MATSUS_0000030 "virgin material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000030 "A material that has never been processed into any form of an end-use product."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000030 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. Use the existing positive secondary material class MATSUS_0000003. Do not create NonVirginMaterial or model non-virgin material as the complement of virgin material. Later: add recovered-content, composition, and proportion axioms only from an approved competency query.")
AnnotationAssertion(:integrationMethod :MATSUS_0000030 "new MatSus subclass of PMDco material")
SubClassOf(:MATSUS_0000030 <https://w3id.org/pmd/co/PMD_0000000>)

# Class: :MATSUS_0000031 (repurposing process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000031 "MKB1 IR2 Class Review: MKB-000202; SRC-001 Circular Berlin")
AnnotationAssertion(rdfs:label :MATSUS_0000031 "repurposing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000031 "A planned process in which a product, component, or material is prepared or modified so that it can fulfil a purpose different from its preceding intended purpose."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000031 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. No maintained compatible repurposing-process class was verified in the reviewed sources. Later: represent prior purpose, new purpose, participants, inputs, and outputs.")
AnnotationAssertion(:integrationMethod :MATSUS_0000031 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000031 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000032 (battery repurposing process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000032 "MKB1 IR2 Class Review: MKB-000009; SRC-002 Ellen MacArthur Foundation")
AnnotationAssertion(rdfs:label :MATSUS_0000032 "battery repurposing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000032 "A repurposing process whose primary participant is a battery or battery component."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000032 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. Later: add battery-participant and second-life or new-purpose relations from an approved use case.")
AnnotationAssertion(:integrationMethod :MATSUS_0000032 "new MatSus subclass of repurposing process")
SubClassOf(:MATSUS_0000032 :MATSUS_0000031)

# Class: :MATSUS_0000033 (resource-input reduction process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000033 "MKB1 IR2 Class Review: MKB-000180; SRC-001 Circular Berlin")
AnnotationAssertion(rdfs:label :MATSUS_0000033 "resource-input reduction process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000033 "A planned process intended to reduce the amount of material input used by a specified process or system."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000033 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. Keep this process distinct from resource-input reduction assessment MATSUS_0000005 and resource-input reduction objective specification MATSUS_0000006. Later: model the affected process or system, material input, stated baseline, comparison conditions, and comparable output or function.")
AnnotationAssertion(:integrationMethod :MATSUS_0000033 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000033 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000034 (refill process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000034 "MKB1 IR2 Class Review: MKB-000181 and MKB-000182; SRC-002 Ellen MacArthur Foundation")
AnnotationAssertion(rdfs:label :MATSUS_0000034 "refill process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000034 "A planned process in which a product container or dispensing device is supplied again with a material product for further use without first becoming waste."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000034 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. MKB-000181 and MKB-000182 are consolidated into this one generic process; at-home and on-the-go are source contexts, not subclasses. Later: model container or device, refilled material, location, agent, and context relations.")
AnnotationAssertion(:integrationMethod :MATSUS_0000034 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000034 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000035 (refusal process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000035 "MKB1 IR2 Class Review: MKB-000184; SRC-001 Circular Berlin")
AnnotationAssertion(rdfs:label :MATSUS_0000035 "refusal process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000035 "A planned process in which an agent intentionally declines to acquire, accept, or use a specified product, material, or service in order to avoid its associated resource use or waste generation."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000035 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. Refusal process represents the actual intentional refusal occurrence. It does not represent the strategy specification or objective specification that motivates, enables, or encourages that occurrence. Later: add agent, refused entity or service, and avoidance-objective relations.")
AnnotationAssertion(:integrationMethod :MATSUS_0000035 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000035 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000036 (remanufacturing process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000036 "MKB1 IR2 Class Review: MKB-000189; SRC-003 European Environment Agency")
AnnotationAssertion(rdfs:label :MATSUS_0000036 "remanufacturing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000036 "A planned process in which a used product or component is restored to a specified performance and quality state through inspection and one or more restorative operations."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000036 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. The remanufacturing process remains distinct from the separate AutomatCE remanufacturability disposition candidate. Later: model used input, retained identity or components, restorative operations, and specified output state.")
AnnotationAssertion(:integrationMethod :MATSUS_0000036 "new MatSus subclass of COB planned process")
SubClassOf(:MATSUS_0000036 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000037 (decoupling datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000037 "MKB1 IR2 Class Review: MKB-000002, SRC-003 European Environment Agency; MKB-000069, SRC-002 Ellen MacArthur Foundation")
AnnotationAssertion(rdfs:label :MATSUS_0000037 "decoupling datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000037 "A data item that records a comparison over a stated time interval in which the rate of change of a resource input or environmental pressure is lower than the rate of change of a specified economic or service output."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000037 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. This records the established sustainability and resource-efficiency meaning of decoupling, not dismantling, disassembly, or another physical separation process. Later: model absolute and relative classifications, baseline and comparison interval, resource-input or environmental-pressure indicator, economic or service-output indicator, calculation method, ratio, and temporal relations.")
AnnotationAssertion(:integrationMethod :MATSUS_0000037 "new MatSus subclass of IAO data item")
SubClassOf(:MATSUS_0000037 <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: :MATSUS_0000038 (modularity)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000038 "MKB1 IR2 Class Review: MKB-000146; SRC-002 Ellen MacArthur Foundation")
AnnotationAssertion(rdfs:label :MATSUS_0000038 "modularity"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000038 "A quality of an entity that reflects the degree to which its parts are organized into separable, replaceable, or recombinable modules."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000038 "Human-gate-authorized MKB1 IR2 Batch 3 implementation. Modularity is a dependent quality of a bearer, not an object aggregate. Later: model the bearer, measurement datum, degree, method, and any device- or design-specific subclasses.")
AnnotationAssertion(:integrationMethod :MATSUS_0000038 "new MatSus subclass of BFO quality")
SubClassOf(:MATSUS_0000038 <http://purl.obolibrary.org/obo/BFO_0000019>)

# Class: :MATSUS_0000039 (refusal strategy specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000039 "MKB1 IR2 human-gate modelling refinement derived from MKB-000184 and the 2026-09-04 Batch 3 review")
AnnotationAssertion(rdfs:comment :MATSUS_0000039 "Examples include optional packaging, opt-out disposable accessories, and service provision that avoids supplying a material product. This class denotes the strategy specification; the actual refusal occurrence is represented by refusal process."@en)
AnnotationAssertion(rdfs:label :MATSUS_0000039 "refusal strategy specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000039 "A plan specification that prescribes product, packaging, or service features intended to enable or encourage a refusal process and thereby avoid material use or waste generation."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000039 "Human-gate-authorized MKB1 IR2 Batch 3 addition derived from the MKB-000184 RefusalProcess review and the 2026-09-04 Batch 3 review. Relations to refusal processes, resource-input-reduction objectives, design specifications, affected product features, and realization remain deferred. Do not assert that every refusal process realizes a refusal strategy specification or add another logical relation between these classes in this batch.")
AnnotationAssertion(:integrationMethod :MATSUS_0000039 "new MatSus subclass of IAO plan specification")
SubClassOf(:MATSUS_0000039 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :BatteryCarbonFootprintInformation (battery carbon footprint information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryCarbonFootprintInformation <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryCarbonFootprintInformation "BatteryPass-ready Data Attribute Long List v1.3, attributes 28-35")
AnnotationAssertion(rdfs:label :BatteryCarbonFootprintInformation "battery carbon footprint information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :BatteryCarbonFootprintInformation "A DPP data item that records a calculated greenhouse-gas emissions result for a battery under a specified method, system boundary, and functional unit."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :BatteryCarbonFootprintInformation "This is a calculated indicator/data item, not an intrinsic material quality. Detailed LCA methodology alignment is deferred to the CLEO stage.")
AnnotationAssertion(:integrationMethod :BatteryCarbonFootprintInformation "new MatSus DPP data-item class based on BatteryPass requirements")
SubClassOf(:BatteryCarbonFootprintInformation <http://purl.obolibrary.org/obo/IAO_0000027>)
SubClassOf(:BatteryCarbonFootprintInformation <http://w3id.org/dppo/ontology/dpp-info/DPPInformation>)

# Class: :BatteryLabelInformation (battery label information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryLabelInformation <urn:samm:io.BatteryPass.Labels:1.2.0#labels>)
AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryLabelInformation "BatteryPass-ready Data Attribute Long List v1.3, attributes 21-25")
AnnotationAssertion(rdfs:label :BatteryLabelInformation "battery label information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :BatteryLabelInformation "DPP information about labels, symbols, and their meanings that are attached to or applicable to a battery."@en)
AnnotationAssertion(:integrationMethod :BatteryLabelInformation "new MatSus DPP information class based on BatteryPass requirements")
SubClassOf(:BatteryLabelInformation <http://w3id.org/dppo/ontology/dpp-info/DPPInformation>)

# Class: :BatteryModelSpecification (battery model specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :BatteryModelSpecification "BatteryPass-ready Data Attribute Long List v1.3, attribute 7")
AnnotationAssertion(rdfs:label :BatteryModelSpecification "battery model specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :BatteryModelSpecification "A material specification that describes a battery model."@en)
AnnotationAssertion(:integrationMethod :BatteryModelSpecification "new MatSus subclass of PMDco material specification")
AnnotationAssertion(:integrationNote :BatteryModelSpecification "The model/batch/item distinction is represented through specification, existing lot/batch identifier patterns, identifiers and later SHACL rather than a new product-batch hierarchy.")
SubClassOf(:BatteryModelSpecification <https://w3id.org/pmd/co/PMD_0060007>)

# Class: :DPPGranularityDatum (DPP granularity datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :DPPGranularityDatum "BatteryPass-ready Data Attribute Long List v1.3, attribute 3")
AnnotationAssertion(rdfs:label :DPPGranularityDatum "DPP granularity datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :DPPGranularityDatum "A data item that records whether the product identifier associated with a Digital Product Passport denotes a product model, batch, or individual item."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :DPPGranularityDatum "Granularity values are represented as literals and will be constrained in SHACL. The accepted PMD lot/LOG lot alignment and LOG batch identifier remain authoritative; no new batch class is introduced.")
AnnotationAssertion(:integrationMethod :DPPGranularityDatum "new MatSus data-item class")
SubClassOf(:DPPGranularityDatum <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: :DPPStatusDatum (DPP status datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :DPPStatusDatum "BatteryPass-ready Data Attribute Long List v1.3, attribute 2")
AnnotationAssertion(rdfs:label :DPPStatusDatum "DPP status datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :DPPStatusDatum "A data item that records the lifecycle status of a Digital Product Passport as a digital resource."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :DPPStatusDatum "Status values are represented as literals and will be constrained in a later SHACL layer; no OWL or SKOS value vocabulary is introduced here.")
AnnotationAssertion(:integrationMethod :DPPStatusDatum "new MatSus data-item class")
