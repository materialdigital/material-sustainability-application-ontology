AnnotationAssertion(rdfs:label :MATSUS_0000057 "indicator result"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000057 "An assessment result datum that records a quantitative indicator value determined according to a metric specification."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000057 "This class is distinct from metric specification and from the OBI value specification carrying its numeric or structured value. SSbD Indicator has a different input/property meaning."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000057 "relatedMatch only; annotation-only; non-entailing")
AnnotationAssertion(:integrationBasis :MATSUS_0000057 "MKB1 ADD-SCO-011 indicator-value carryover, existing MATSUS_0000027, SSbD Indicator mismatch, and CLEO result example reviewed; final human decisions 5 and 9.")
AnnotationAssertion(:integrationMethod :MATSUS_0000057 "MatSus-local class using the pinned PMDco/IAO/OBI backbone; external correspondence is annotation-only and non-entailing")
AnnotationAssertion(:integrationNote :MATSUS_0000057 "SSbD Indicator is an input/property; CLEO's mapped class is climate-specific and carries the rejected carbon-dioxide-equivalent-disposition restriction.")
AnnotationAssertion(:mappedTo :MATSUS_0000057 <https://w3id.org/ssbd/Indicator>)
