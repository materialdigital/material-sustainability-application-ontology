SubClassOf(:MATSUS_0000067 :MATSUS_0000048)

# Class: :MATSUS_0000068 (life cycle assessment specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000068 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000068 "life cycle assessment specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000068 "An assessment specification that prescribes the scope, reference basis, system boundary, and other methodological choices for a life cycle assessment process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000068 "Functional unit, reference flow, and system boundary specifications are represented as information parts of the life cycle assessment specification."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000068 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18.")
AnnotationAssertion(:integrationMethod :MATSUS_0000068 "MatSus-local specialization of assessment specification")
SubClassOf(:MATSUS_0000068 :MATSUS_0000053)
SubClassOf(:MATSUS_0000068 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000069))
SubClassOf(:MATSUS_0000068 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000070))
SubClassOf(:MATSUS_0000068 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000071))

# Class: :MATSUS_0000069 (functional unit specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000069 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000069 "functional unit specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000069 "A directive information entity that specifies a quantified performance used as the reference basis of a life cycle assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000069 "This is information specifying the reference basis of the assessment, not a physical unit and not the assessed process itself."@en)
AnnotationAssertion(:integrationMethod :MATSUS_0000069 "MatSus-local directive information entity")
SubClassOf(:MATSUS_0000069 <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: :MATSUS_0000070 (reference flow specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000070 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000070 "reference flow specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000070 "An information content entity that specifies the quantity of product or material flow required to fulfil the functional unit of a life cycle assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000070 "The exact directive-information subtype is intentionally not asserted in this increment."@en)
AnnotationAssertion(:integrationMethod :MATSUS_0000070 "MatSus-local information-content specialization")
SubClassOf(:MATSUS_0000070 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000071 (system boundary specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000071 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000071 "system boundary specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000071 "A directive information entity that specifies which processes or activities are included in or excluded from the system evaluated by a life cycle assessment."@en)
AnnotationAssertion(:integrationMethod :MATSUS_0000071 "MatSus-local directive information entity")
SubClassOf(:MATSUS_0000071 <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: :MATSUS_0000072 (system model)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000072 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000072 "system model"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000072 "An information content entity that represents processes, flows, and relationships of a system for assessment or analysis."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000072 "This is a generic system-model class. A separate lifecycle system model is intentionally deferred."@en)
AnnotationAssertion(:integrationMethod :MATSUS_0000072 "MatSus-local generic information-content specialization")
SubClassOf(:MATSUS_0000072 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000073 (impact category)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000073 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000073 "impact category"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000073 "An information content entity that represents an environmental issue of concern evaluated in a life cycle impact assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000073 "An impact category is information used to organize and interpret impact assessment; it is not itself an assessment process or environmental effect."@en)
AnnotationAssertion(:integrationMethod :MATSUS_0000073 "MatSus-local information-content specialization")
SubClassOf(:MATSUS_0000073 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000074 (life cycle assessment result information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000074 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000074 "life cycle assessment result information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000074 "Assessment result information that represents a finding or outcome obtained through a life cycle assessment process."@en)
AnnotationAssertion(:integrationMethod :MATSUS_0000074 "MatSus-local specialization of assessment result information")
SubClassOf(:MATSUS_0000074 :MATSUS_0000055)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000076 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000076 "carbon footprint result"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> :MATSUS_0000076 "carbon footprint"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000076 "An indicator result that quantifies greenhouse gas emissions and removals associated with a specified subject and scope as carbon dioxide equivalents for the climate-change impact category."@en)
AnnotationAssertion(rdfs:comment :MATSUS_0000076 "The applicable scope, method, global-warming-potential time horizon, and completeness depend on the governing specification. Membership in this class does not by itself imply a complete life cycle assessment or conformity with a particular standard."@en)
