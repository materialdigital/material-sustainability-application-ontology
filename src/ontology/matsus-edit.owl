# Class: :MATSUS_0000052 (sustainability-relevant functionality assessment)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000052 "MKB2 SRC-005/SRC-006 final human decision, 2026-09-16")
AnnotationAssertion(rdfs:label :MATSUS_0000052 "sustainability-relevant functionality assessment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000052 "An assessment process that evaluates whether or how well an entity or process fulfils a stated function or performance requirement in a sustainability or SSbD decision context."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000052 "Ordinary material-characterization assays are not subclasses merely because they measure functional properties. PMDco assays and their results may be subprocesses or evidence when a concrete assessment uses them."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000052 "narrower MatSus correspondence; annotation-only; non-entailing")
AnnotationAssertion(:integrationBasis :MATSUS_0000052 "SRC-005 SSbD FunctionalityAssessment and pinned PMDco assay comparison; sustainability-context narrowing fixed by final human decision 4.")
AnnotationAssertion(:integrationMethod :MATSUS_0000052 "MatSus-local class using the pinned PMDco/IAO/OBI backbone; external correspondence is annotation-only and non-entailing")
AnnotationAssertion(:integrationNote :MATSUS_0000052 "MatSus requires a sustainability or SSbD decision context; ordinary characterization is not included automatically.")
AnnotationAssertion(:mappedTo :MATSUS_0000052 <https://w3id.org/ssbd/FunctionalityAssessment>)
SubClassOf(:MATSUS_0000052 :MATSUS_0000043)

# Class: :MATSUS_0000053 (assessment specification)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000053 "MKB2 SRC-005/SRC-006 final human decision, 2026-09-16")
AnnotationAssertion(rdfs:label :MATSUS_0000053 "assessment specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000053 "A plan specification that prescribes how an assessment process is to be conducted in order to achieve a stated assessment objective."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000053 "This is directive information, not a report, result, material input, or process. It inherits the plan-specification requirements for objective- and action-specification parts. A merely retrospective description is not thereby an assessment specification."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000053 "partial relatedMatch; annotation-only; non-entailing")
AnnotationAssertion(:integrationBasis :MATSUS_0000053 "MKB1 assessment-method/specification carryover; imported IAO plan-specification axioms; CLEO lifecycle calculation request reviewed as partial evidence; final human decision 6.")
AnnotationAssertion(:integrationMethod :MATSUS_0000053 "MatSus-local class using the pinned PMDco/IAO/OBI backbone; external correspondence is annotation-only and non-entailing")
AnnotationAssertion(:integrationNote :MATSUS_0000053 "CLEO lifecycle calculation request is a parameter specification, not a general assessment specification. No mapping to SSbD SpecifiedAssessment is asserted because that class denotes a process.")
AnnotationAssertion(:mappedTo :MATSUS_0000053 <http://purl.obolibrary.org/obo/CLEO_0000007>)
SubClassOf(:MATSUS_0000053 <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: :MATSUS_0000054 (assessment output information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000054 "MKB2 SRC-005/SRC-006 final human decision, 2026-09-16")
AnnotationAssertion(rdfs:label :MATSUS_0000054 "assessment output information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000054 "An information content entity that is produced or compiled as an informational output concerning an assessment process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000054 "This is the broad common category for informational outputs of an assessment. It includes actual findings and documents but is not limited to either, and it does not imply specified-output provenance without an explicit process assertion."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000054 "loose information-level correspondence; annotation-only; non-entailing")
AnnotationAssertion(:integrationBasis :MATSUS_0000054 "SRC-005 information-output requirement and MKB1 process/specification/output distinction; final human decision 5.")
AnnotationAssertion(:integrationMethod :MATSUS_0000054 "MatSus-local class using the pinned PMDco/IAO/OBI backbone; external correspondence is annotation-only and non-entailing")
AnnotationAssertion(:integrationNote :MATSUS_0000054 "SSbD Sign/Data categories are not aligned to BFO/IAO.")
AnnotationAssertion(:mappedTo :MATSUS_0000054 <https://w3id.org/ssbd/Information>)
SubClassOf(:MATSUS_0000054 <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: :MATSUS_0000055 (assessment result information)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000055 "MKB2 SRC-005/SRC-006 final human decision, 2026-09-16")
AnnotationAssertion(rdfs:label :MATSUS_0000055 "assessment result information"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000055 "Assessment output information that represents an actual finding or outcome obtained through an assessment process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000055 "This is the common parent for quantitative and qualitative findings. A plan, method, or report is not an individual result merely because it discusses one."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000055 "loose result-information correspondence; annotation-only; non-entailing")
AnnotationAssertion(:integrationBasis :MATSUS_0000055 "SRC-005 findings architecture and MKB1 result-information carryover; final human decision 5.")
AnnotationAssertion(:integrationMethod :MATSUS_0000055 "MatSus-local class using the pinned PMDco/IAO/OBI backbone; external correspondence is annotation-only and non-entailing")
AnnotationAssertion(:integrationNote :MATSUS_0000055 "SSbD Property is a semiotic Sign, not a BFO quality or MatSus result class.")
AnnotationAssertion(:mappedTo :MATSUS_0000055 <https://w3id.org/ssbd/Property>)
AnnotationAssertion(:mappedTo :MATSUS_0000055 <https://w3id.org/ssbd/Description>)
SubClassOf(:MATSUS_0000055 :MATSUS_0000054)

# Class: :MATSUS_0000056 (assessment result datum)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000056 "MKB2 SRC-005/SRC-006 final human decision, 2026-09-16")
AnnotationAssertion(rdfs:label :MATSUS_0000056 "assessment result datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000056 "A data item that is assessment result information and records an actual finding or outcome obtained through an assessment process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000056 "This class inherits IAO's truth-intended and reliable-method semantics. It is not the process, specification, or report that generated or communicates it."@en)
AnnotationAssertion(:alignmentRelation :MATSUS_0000056 "broader MatSus result-datum correspondence; annotation-only; non-entailing")
AnnotationAssertion(:integrationBasis :MATSUS_0000056 "Imported IAO data-item semantics, SSbD Datum, and CLEO lifecycle-analysis result datum reviewed; final human decision 5.")
AnnotationAssertion(:integrationMethod :MATSUS_0000056 "MatSus-local class using the pinned PMDco/IAO/OBI backbone; external correspondence is annotation-only and non-entailing")
AnnotationAssertion(:integrationNote :MATSUS_0000056 "CLEO is lifecycle-specific and SSbD uses a different upper category.")
AnnotationAssertion(:mappedTo :MATSUS_0000056 <https://w3id.org/ssbd/Datum>)
AnnotationAssertion(:mappedTo :MATSUS_0000056 <http://purl.obolibrary.org/obo/CLEO_0000002>)
SubClassOf(:MATSUS_0000056 <http://purl.obolibrary.org/obo/IAO_0000027>)
