# Class: :MATSUS_0000065 (life cycle assessment process)

AnnotationAssertion(<http://purl.org/dc/terms/source> :MATSUS_0000065 "MKB2 SRC-006 LCA architecture final human decision, 2026-09-18")
AnnotationAssertion(rdfs:label :MATSUS_0000065 "life cycle assessment process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000065 "A sustainability assessment that compiles and evaluates inputs, outputs, and potential environmental impacts associated with a product system across its life cycle."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000065 "Life cycle inventory analysis and life cycle impact assessment are represented as process parts of a life cycle assessment, not as subclasses of it. No universal specified-output restriction is asserted."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000065 "MKB2 SRC-006 CLEO/LCA source gate and final MatSus LCA architecture decision, 2026-09-18.")
AnnotationAssertion(:integrationMethod :MATSUS_0000065 "MatSus-local sustainability-assessment specialization using the existing PMDco/IAO/OBI backbone")
SubClassOf(:MATSUS_0000065 :MATSUS_0000048)
SubClassOf(:MATSUS_0000065 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> :MATSUS_0000066))
