AnnotationAssertion(rdfs:label :MATSUS_0000066 "life cycle inventory analysis process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000066 "A planned process that compiles and quantifies inputs and outputs relevant to a life cycle assessment."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000066 "This process is modelled under planned process rather than assessment process. Its occurrence may be a process part of a life cycle assessment."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000066 "MKB2 SRC-006 CLEO/LCA source gate and final MatSus LCA architecture decision, 2026-09-18.")
AnnotationAssertion(:integrationMethod :MATSUS_0000066 "MatSus-local planned-process specialization")
SubClassOf(:MATSUS_0000066 <http://purl.obolibrary.org/obo/COB_0000082>)

# Class: :MATSUS_0000067 (life cycle impact assessment process)

