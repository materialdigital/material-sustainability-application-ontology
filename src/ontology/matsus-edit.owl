AnnotationAssertion(rdfs:label :MATSUS_0000067 "life cycle impact assessment process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> :MATSUS_0000067 "A sustainability assessment that evaluates potential environmental impacts using life cycle inventory information and impact categories."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#editorialNote> :MATSUS_0000067 "This class is parallel to life cycle assessment under sustainability assessment and may occur as a process part of a life cycle assessment."@en)
AnnotationAssertion(:integrationBasis :MATSUS_0000067 "MKB2 SRC-006 CLEO/LCA source gate and final MatSus LCA architecture decision, 2026-09-18.")
