@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix log: <https://w3id.org/pmd/log/> .
@prefix matsus: <https://w3id.org/pmd/matsus/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pmd: <https://w3id.org/pmd/co/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

obo:BFO_0000082 a owl:ObjectProperty .
obo:BFO_0000196 a owl:ObjectProperty .
obo:BFO_0000197 a owl:ObjectProperty .
obo:RO_0002502 a owl:ObjectProperty .

pmd:PMD_0040121 a owl:ObjectProperty ;
    rdfs:label "specifies role"@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range obo:BFO_0000023 ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    owl:inverseOf pmd:PMD_0040122 ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    skos:editorialNote "LOGao supplies this PMDco-namespace object property for compatibility. It is absent from the pinned PMDco release and should not be used as an authoritative PMDco backbone property without checking the upstream release."@en .

pmd:PMD_0040129 a owl:Class ;
    rdfs:label "supply chain objective specification" ;
    rdfs:subClassOf obo:IAO_0000005 ;
    skos:definition "objective specification that prescribes what the outcome of a supply chain process should be" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    skos:editorialNote "LOGao supplies this PMDco-namespace class for compatibility. It is absent from the pinned PMDco release and should not be used as an authoritative PMDco backbone class without checking the upstream release."@en .

pmd:PMD_0040151 a owl:Class ;
    rdfs:label "storage function" ;
    rdfs:subClassOf obo:BFO_0000034 ;
    skos:definition "function of an material entity to store other material entities" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    skos:editorialNote "LOGao supplies this PMDco-namespace class for compatibility. It is absent from the pinned PMDco release and should not be used as an authoritative PMDco backbone class without checking the upstream release."@en .

log:LOG_0000000 a owl:Class ;
    rdfs:label "industrial inventory" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_0000001 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_0000001 ],
        log:LOG_1000030 ;
    skos:definition "material product, material component, raw material, or material artifact that is ready to be sold or used and is stored in a storage facility or on factory floor" .

log:LOG_0000002 a owl:Class ;
    rdfs:label "consigning process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "business process that results in placing a material entity in the possession of some agent without changing the ownership until the material entity is sold" .

log:LOG_0080000 a owl:Class ;
    rdfs:label "manufacturer identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000196 ;
                                owl:someValuesFrom obo:OBI_0000571 ] ) ] ],
        log:LOG_1000006 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000219 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000196 ;
                                            owl:someValuesFrom obo:OBI_0000571 ] ) ] ] ) ] .

log:LOG_0080001 a owl:Class ;
    rdfs:label "product identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom log:LOG_1000029 ],
        obo:IAO_0020000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom log:LOG_1000029 ] .

log:LOG_0080002 a owl:Class ;
    rdfs:label "batch identifier" ;
    rdfs:subClassOf obo:IAO_0020000 ;
    skos:definition "denotes all material artifact generated by one distinguishable manufacturing process run" .

log:LOG_1000002 a owl:Class ;
    rdfs:label "bill of lading" ;
    rdfs:subClassOf log:LOG_1000001 ;
    skos:definition "agreement between a shipper and a carrier that prescribes some consigning process" .

log:LOG_1000004 a owl:Class ;
    rdfs:label "purchase order" ;
    rdfs:subClassOf log:LOG_1000000 ;
    skos:definition "agreement between a buyer and a vendor (supplier) that that contains a set of commitments on the buyer and the vendeor" .

log:LOG_1000007 a owl:Class ;
    rdfs:label "part number" ;
    rdfs:subClassOf obo:IAO_0020000 ;
    skos:definition "identifier that uniquely identifies an artifact (material artifact) and that is created according to some part numbering system" .

log:LOG_1000009 a owl:Class ;
    rdfs:label "global location number" ;
    rdfs:subClassOf log:LOG_1000008 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000008 [ a owl:Class ;
                        owl:unionOf ( pmd:PMD_0040030 [ a owl:Restriction ;
                                    owl:onProperty obo:IAO_0000219 ;
                                    owl:someValuesFrom log:LOG_1000050 ] ) ] [ a owl:Restriction ;
                        owl:hasValue pmd:PMD_0040128 ;
                        owl:onProperty pmd:PMD_0000004 ] ) ] ;
    skos:definition "identifer that uniquely identifies a business organization or a geospatial location and complies with GS1 GLN coding scheme" .

log:LOG_1000010 a owl:Class ;
    rdfs:label "location identification scheme" ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "identification scheme that prescribes how unique identifiers of physical locations are formulated" .

log:LOG_10000105 a owl:Class ;
    rdfs:label "customer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000058 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000058 ],
        log:LOG_1000011 ;
    skos:definition "person or organization which has a customer role" .

log:LOG_1000012 a owl:Class ;
    rdfs:label "buyer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000055 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000055 ],
        log:LOG_1000011 ;
    skos:definition "person or organization which has a buyer role" .

log:LOG_1000013 a owl:Class ;
    rdfs:label "consignee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000056 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000056 ],
        log:LOG_1000011 ;
    skos:definition "person or business organization that receives some shipment" .

log:LOG_1000014 a owl:Class ;
    rdfs:label "consignor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000057 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000057 ],
        log:LOG_1000011 ;
    skos:definition "person or business organization that prepares and sends shipments for transport" .

log:LOG_1000015 a owl:Class ;
    rdfs:label "distributor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000060 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000060 ],
        log:LOG_1000011 ;
    skos:definition "person or business organization when it purchases products from manufacturers and resells them to wholesalers" .

log:LOG_1000017 a owl:Class ;
    rdfs:label "manufacturer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom obo:OBI_0000571 ],
        obo:OBI_0000835,
        log:LOG_1000011,
        log:LOG_1000050 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom obo:OBI_0000571 ] ) ] ;
    skos:definition "organization which has a manufacturer role" ;
    matsus:alignmentRelation "narrower than or aligned with OBI manufacturer" ;
    skos:editorialNote "A LOG manufacturer is an organization in the LOG agent branch that bears a manufacturer role. Its OBI correspondence preserves that LOG agent structure."@en .

log:LOG_1000018 a owl:Class ;
    rdfs:label "retailer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000062 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000062 ],
        log:LOG_1000011 ;
    skos:definition "person or business organization who buys products from wholesalers and manufacturers and resells them to end users" .

log:LOG_1000024 a owl:Class ;
    rdfs:label "wholesaler" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000072 ],
        log:LOG_1000011 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000011 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000072 ] ) ] ;
    skos:definition "person or business organization that buys products from distributors and resells them to retailers or other business organizations" .

log:LOG_1000025 a owl:Class ;
    rdfs:label "cargo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000073 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000073 ] ) ] ;
    skos:definition "material entity that is transported using a transport equipment by a carrier" .

log:LOG_1000026 a owl:Class ;
    rdfs:label "load" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000082 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000082 ] ) ] ;
    skos:definition "collection of material entities which share the same transportation and transfer history" .

log:LOG_1000027 a owl:Class ;
    rdfs:label "maintainable material item" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000104 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000104 ] ) ] ;
    skos:definition "material artifact or engineered system which has the maintainable material item role" .

log:LOG_1000031 a owl:Class ;
    rdfs:label "department" ;
    rdfs:subClassOf obo:BFO_0000027 ;
    skos:definition "object aggregate that is part of an organisation and consists of persons that are members of the same organisation" .

log:LOG_1000033 a owl:Class ;
    rdfs:label "laboratory" ;
    rdfs:subClassOf log:LOG_1000032 ;
    skos:definition "A place equipped for experimental study in a science or for testing and analysis." .

log:LOG_1000035 a owl:Class ;
    rdfs:label "distribution center" ;
    rdfs:subClassOf log:LOG_1000034 ;
    skos:definition "storage facility designed to store manufactured products that are to be distributed to resellers and wholesalers" .

log:LOG_1000036 a owl:Class ;
    rdfs:label "logistic unit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000083 ],
        [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000235 ;
            owl:someValuesFrom obo:IAO_0020000 ],
        obo:BFO_0000027 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000083 ] [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000235 ;
                        owl:someValuesFrom obo:IAO_0020000 ] ) ] ;
    skos:definition "material entities packaged together for transport or storage" .

log:LOG_1000039 a owl:Class ;
    rdfs:label "manufacturing supply chain system" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( log:LOG_10001247 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002234 ;
                                owl:someValuesFrom log:LOG_1000029 ] ) ] ],
        log:LOG_1000038 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000038 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000056 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_10001247 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0002234 ;
                                            owl:someValuesFrom log:LOG_1000029 ] ) ] ] ) ] ;
    skos:definition "supply chain system that is formed to manufacture one or more products" .

log:LOG_1000040 a owl:Class ;
    rdfs:label "service supply chain system" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom log:LOG_1000112 ],
        log:LOG_1000038 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000038 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000056 ;
                        owl:someValuesFrom log:LOG_1000112 ] ) ] ;
    skos:definition "supply chain system that is formed to deliver some commercial services" .

log:LOG_1000042 a owl:Class ;
    rdfs:label "container" ;
    rdfs:subClassOf log:LOG_1000041 ;
    skos:definition "piece of transport equipment that is designed to contain some material entities" .

log:LOG_1000043 a owl:Class ;
    rdfs:label "trailer" ;
    rdfs:subClassOf log:LOG_1000041 ;
    skos:definition "piece of transport equipment that is unpowered and is pulled by a powered vehicle" .

log:LOG_1000044 a owl:Class ;
    rdfs:label "wagon" ;
    rdfs:subClassOf log:LOG_1000041 ;
    skos:definition "piece of transport equipment in a rail transport system used for carrying cargo or passengers" .

log:LOG_1000046 a owl:Class ;
    rdfs:label "integrated carrier business organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000053 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000052 ],
        log:LOG_1000047 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000047 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000052 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000053 ] ) ] ;
    skos:definition "business organization that is created for the purpose of providing different types of transportation and freight forwarding services" .

log:LOG_1000059 a owl:Class ;
    rdfs:label "service consumer role" ;
    rdfs:subClassOf log:LOG_1000058 ;
    skos:definition "customer role held by a person or business organization when it receives and consumes a service" .

log:LOG_1000061 a owl:Class ;
    rdfs:label "manufacturer role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom log:LOG_1000123 ] ) ] ],
        obo:OBI_0000571,
        log:LOG_1000054 ;
    skos:definition "agent role held by an organization when it produces material products" ;
    matsus:alignmentRelation "narrower than or aligned with OBI manufacturer role" ;
    skos:editorialNote "The role of an organization producing material products is aligned with the OBI manufacturer role within the LOG agent-role hierarchy."@en .

log:LOG_1000066 a owl:Class ;
    rdfs:label "manufacturing service provider role" ;
    rdfs:subClassOf log:LOG_1000064 ;
    skos:definition "service provider role that is held by a person or business organization when it provides a manufacturing service" .

log:LOG_1000068 a owl:Class ;
    rdfs:label "packaging service provider role" ;
    rdfs:subClassOf log:LOG_1000065 ;
    skos:definition "logisitics service provider role held by a business organization or person when it provides a packaging service" .

log:LOG_1000069 a owl:Class ;
    rdfs:label "storage service provider role" ;
    rdfs:subClassOf log:LOG_1000065 ;
    skos:definition "logisitics service provider role that is held by a person or business organization when it provides a storage service" .

log:LOG_1000079 a owl:Class ;
    rdfs:label "raw material role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( log:LOG_1000123 [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_1000131 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000132 ;
                                            owl:someValuesFrom log:LOG_1000123 ] ) ] ) ] ;
            owl:onProperty obo:BFO_0000054 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( log:LOG_1000111 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0000057 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                                                                        owl:onProperty obo:BFO_0000196 ;
                                                                        owl:someValuesFrom log:LOG_1000055 ] ) ] ] ) ] ] ) ] ],
        obo:BFO_0000023 ;
    skos:definition "role held by a material entity when it is acquired by an organizational entity with some plan to transform or modify it into intermediate-level components or substances or into a product" .

log:LOG_1000088 a owl:Class ;
    rdfs:label "ship from location" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000075 ],
        pmd:PMD_0040030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000075 ] ) ] ;
    skos:definition "geospatial location at which some dispatch process occurs" .

log:LOG_1000089 a owl:Class ;
    rdfs:label "ship to location" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000076 ],
        pmd:PMD_0040030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000076 ] ) ] ;
    skos:definition "geospatial location in which some receiving process occurs" .

log:LOG_1000090 a owl:Class ;
    rdfs:label "supply chain node" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000077 ],
        pmd:PMD_0040030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000077 ] ) ] ;
    skos:definition "geospatial location that is the site of some supply chain process" .

log:LOG_1000093 a owl:Class ;
    rdfs:label "commercial service specification" ;
    rdfs:subClassOf obo:IAO_0000104 ;
    skos:definition "plan specification that prescribes a commercial service" .

log:LOG_1000096 a owl:Class ;
    rdfs:label "shipment plan specification" ;
    rdfs:subClassOf obo:IAO_0000104 ;
    skos:definition "plan specification that prescribes a shipment preparation process and a transportation process" .

log:LOG_1000099 a owl:Class ;
    rdfs:label "airway" ;
    rdfs:subClassOf obo:BFO_0000028 ;
    skos:definition "three-dimensional spatial region that connects one specified location (navigation point) to another at a specified altitude, along which an aircraft may be flown" .

log:LOG_1000100 a owl:Class ;
    rdfs:label "seaway" ;
    rdfs:subClassOf obo:BFO_0000028 ;
    skos:definition "three-dimensional spatial region that connects one specified location to another on a body of water along which a watercraft may travel" .

log:LOG_1000101 a owl:Class ;
    rdfs:label "shipping route" ;
    rdfs:subClassOf obo:BFO_0000028 ;
    skos:definition "way (three-dimensional spatial region) that connects two or more supply chain nodes along which some shipment travels during a transport process" .

log:LOG_1000102 a owl:Class ;
    rdfs:label "raw material" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "material entity which has the raw material role" .

log:LOG_1000103 a owl:Class ;
    rdfs:label "traceable resource unit" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "material entity that is uniquely identified and there may be a need to retrieve information about its history, application, or location as it moves through a supply chain" .

log:LOG_1000115 a owl:Class ;
    rdfs:label "packaging service" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000113 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom log:LOG_1000121 ] ) ],
        log:LOG_1000113 ;
    skos:definition "logistics service that consists of at lest one packaging process" .

log:LOG_1000116 a owl:Class ;
    rdfs:label "storage service" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000113 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom log:LOG_1000144 ] ) ],
        log:LOG_1000113 ;
    skos:definition "logistics service that consists of at least one storage process" .

log:LOG_1000119 a owl:Class ;
    rdfs:label "inventory management process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "business process that consists of the activities required for controlling, tracking, recording, and planning inventories" .

log:LOG_1000120 a owl:Class ;
    rdfs:label "logistics process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "business process that consists of a combination of one or more transport, shipment preparation, storage or receiving processes" .

log:LOG_1000122 a owl:Class ;
    rdfs:label "procuring business process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "business process that consists of buying and ensuring the supply of products or services" .

log:LOG_1000129 a owl:Class ;
    rdfs:label "warehousing process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000117 ;
            owl:someValuesFrom log:LOG_1000144 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000066 ;
            owl:someValuesFrom log:LOG_1000034 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002233 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000059 ;
                                owl:someValuesFrom log:LOG_1000098 ] ) ] ],
        log:LOG_1000130 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000130 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000066 ;
                        owl:someValuesFrom log:LOG_1000034 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom log:LOG_1000144 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000059 ;
                                            owl:someValuesFrom log:LOG_1000098 ] ) ] ] ) ] ;
    skos:definition "business process of storing products (material products) in a storage facility for future use" .

log:LOG_1000132 a owl:Class ;
    rdfs:label "assembly process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom log:LOG_1000028 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002234 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0002351 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( log:LOG_1000028 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0002352 ;
                                                                owl:someValuesFrom log:LOG_1000131 ] ) ] ] ) ] ] ) ],
        pmd:PMD_0000833,
        log:LOG_1000131 ;
    skos:definition "manufacturing process in which a number of material components are physically connected to each other to form an assembly" .

log:LOG_1000135 a owl:Class ;
    rdfs:label "appraisal process" ;
    rdfs:subClassOf log:LOG_1000134 ;
    skos:definition "measurement process that involves evaluating, assessing, estimating, or judging the nature, value, importance, condition, or quality of some entity" .

log:LOG_1000141 a owl:Class ;
    rdfs:label "arrival process" ;
    rdfs:subClassOf log:LOG_1000140 ;
    skos:definition "material location change process that consists of the participating entity reaching its destination such that the travel or transport process which it is a part of is completed" .

log:LOG_1000142 a owl:Class ;
    rdfs:label "departure process" ;
    rdfs:subClassOf log:LOG_1000140 ;
    skos:definition "material location change process that consists of the participating entity leaving its starting location such that the travel or transport process it is a part of is initiated" .

log:LOG_1000145 a owl:Class ;
    rdfs:label "travel process" ;
    rdfs:subClassOf log:LOG_1000140 ;
    skos:definition "material location change process wherein one or more persons move between geographical locations" .

log:LOG_1900002 a owl:ObjectProperty ;
    rdfs:label "owned by" ;
    rdfs:comment "relationship from a material entity to a person or business organization when the material entity is held by the person or business organization as legal property" ;
    rdfs:domain obo:BFO_0000040 ;
    rdfs:range log:LOG_1000011 ;
    owl:inverseOf log:LOG_1900003 .

<https://w3id.org/pmd/matsus/components/matsus-log-stageA.ttl> a owl:Ontology ;
    dcterms:description log:,
        "Contains selected LOG classes, properties, alignments, compatibility exceptions and definitions curated for Mat.Sus. This Mat.Sus component is adapted from the Platform MaterialDigital Application Ontology for Logistics and Supply Chain (LOG), based on upstream main commit 0c89424ffc17096599d5bfdcfba783686494d49e. The ontology source content at that revision corresponds to LOG v1.0.2." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    dcterms:title "MatSus — LOG integration" .

pmd:PMD_0040122 a owl:ObjectProperty ;
    rdfs:label "role specified by"@en ;
    rdfs:domain obo:BFO_0000023 ;
    rdfs:range obo:IAO_0000030 ;
    rdfs:subPropertyOf pmd:PMD_0000004 ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    skos:editorialNote "LOGao supplies this PMDco-namespace object property for compatibility. It is absent from the pinned PMDco release and should not be used as an authoritative PMDco backbone property without checking the upstream release."@en .

log:LOG_0000003 a owl:Class ;
    rdfs:label "freight forwarding process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000130 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000016 ] ) ],
        log:LOG_1000130 ;
    skos:definition "business process of planning and coordinating the transportation of material products on behalf of a shipper" .

log:LOG_1000016 a owl:Class ;
    rdfs:label "freight forwarder" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000067 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000067 ],
        log:LOG_1000022 ;
    skos:definition "person or business organization when it arranges the transportation of shipments on behalf of the shipper (consignor) or consignee" .

log:LOG_1000019 a owl:Class ;
    rdfs:label "shipper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000057 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000057 ],
        log:LOG_1000011 ;
    skos:definition "person or business organization that prepares and sends shipments for transport" .

log:LOG_1000021 a owl:Class ;
    rdfs:label "carrier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000070 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000070 ],
        log:LOG_1000022 ;
    skos:definition "person or business organization who provides transportation services" .

log:LOG_1000051 a owl:Class ;
    rdfs:label "shipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000081 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000081 ] ) ] ;
    skos:definition "collection of material entities delivered to a receiver's location that have undergone the same dispatch and receipt processes" .

log:LOG_1000095 a owl:Class ;
    rdfs:label "packaging plan specification" ;
    rdfs:subClassOf obo:IAO_0000104 ;
    skos:definition "plan specification that prescribes a packaging process" .

log:LOG_1000118 a owl:Class ;
    rdfs:label "manufacturing service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000117 ;
            owl:someValuesFrom log:LOG_1000131 ],
        log:LOG_1000112 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000112 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom log:LOG_1000131 ] ) ] ;
    skos:definition "commercial service that consists of at least one manufacturing process" .

log:LOG_1000124 a owl:Class ;
    rdfs:label "receiving process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "planned process in which an agent receives some material entity from another agent" .

log:LOG_1000125 a owl:Class ;
    rdfs:label "selling business process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom log:LOG_1000020 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( log:LOG_1000001 log:LOG_1000029 ) ] ],
        log:LOG_1000130 ;
    skos:definition "business process wherein a product or commercial service is offered by an agent (seller) for another agent (buyer) to acquire ownership via a financial instrument" .

log:LOG_1000134 a owl:Class ;
    rdfs:label "measurement process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000011 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000059 ;
                                            owl:someValuesFrom obo:IAO_0000104 ] ) ] ] ) ],
        obo:BFO_0000015 ;
    skos:definition "planned process to determine the value of an attribute (specifically dependent continuant or temporal region or process characteristic) of an entity of interest" .

log:LOG_1000146 a owl:Class ;
    rdfs:label "physical premises" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000082 ;
            owl:someValuesFrom pmd:PMD_0040029 ],
        obo:BFO_0000027 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000082 ;
                        owl:someValuesFrom pmd:PMD_0040029 ] ) ] ;
    skos:definition "object aggregate that has a location at some geospatial site and serves as a physical place of operation for an organization" ;
    matsus:alignmentRelation "distinct from BFO site; related to organizational site" ;
    skos:editorialNote "Physical premises are a material facility modelled as an object aggregate located at a geospatial site. The correspondence to org:Site is conceptual and supplies no superclass."@en .

log:LOG_1900001 a owl:ObjectProperty ;
    rdfs:label "acts on behalf of" ;
    rdfs:comment "relation from a material entity to a person or a group of agents or engineered system that holds when the material entity participates in some planned process in order to fulfill an objective for the person or group of agents or engineered system" ;
    rdfs:domain obo:BFO_0000040 ;
    rdfs:range log:LOG_1000011 .

log:LOG_1900003 a owl:ObjectProperty ;
    rdfs:label "owns" ;
    rdfs:comment "relationship from a person or business organization to an independent continuant when the agent holds the independent continuant as legal property" ;
    rdfs:domain log:LOG_1000011 ;
    rdfs:range obo:BFO_0000004 .

log:LOG_0000001 a owl:Class ;
    rdfs:label "industrial inventory role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:unionOf ( log:LOG_1000123 log:LOG_1000128 ) ] ] ) ] ],
        log:LOG_1000106 ;
    skos:definition "role held by some material entity when it is stored by a bussiness organization and it is intended to be supplied to a customer or to be used or consumed in some product production process" .

log:LOG_1000000 a owl:Class ;
    rdfs:label "agreement" ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "understanding between two or more parties that contains a set of commitments on the part of the parties" .

log:LOG_1000003 a owl:Class ;
    rdfs:label "transport equipment role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "role held by a material artifact when it is planned to be involved in or is involved in carrying out some part of a planned transportation process and that is not consumed in that planned process" .

log:LOG_1000006 a owl:Class ;
    rdfs:label "organization identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom log:LOG_1000050 ],
        obo:IAO_0020000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000219 ;
                        owl:someValuesFrom log:LOG_1000050 ] ) ] ;
    skos:definition "identifier that identifies an organization" .

log:LOG_1000008 a owl:Class ;
    rdfs:label "physical location identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom obo:BFO_0000029 ],
        obo:IAO_0020000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000219 ;
                        owl:someValuesFrom obo:BFO_0000029 ] ) ] ;
    skos:definition "identifier that identifies a physical location (site)" .

log:LOG_1000030 a owl:Class ;
    rdfs:label "material resource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000106 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000106 ] ) ] ;
    skos:definition "material entity which has the material resource role" .

log:LOG_1000032 a owl:Class ;
    rdfs:label "facility" ;
    rdfs:subClassOf log:LOG_1000146 ;
    skos:definition "engineered system that consists of buildings, structures, roads, machines, and equipment desgined to provide certain capabilities" .

log:LOG_1000037 a owl:Class ;
    rdfs:label "lot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000080 ],
        [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000235 ;
            owl:someValuesFrom log:LOG_1000005 ],
        pmd:PMD_0020138 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000080 ] [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000235 ;
                        owl:someValuesFrom log:LOG_1000005 ] ) ] ;
    skos:definition "quantity of material entities produced together and sharing the same production history and specifications" ;
    matsus:alignmentRelation "narrower than PMDco lot" ;
    skos:editorialNote "The shared production history and specifications make this LOG lot narrower than a PMDco lot, so it is a subclass without an equivalence assertion."@en .

log:LOG_1000052 a owl:Class ;
    rdfs:label "freight forwarding business function" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom log:LOG_1000114 ],
        log:LOG_1000091 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000091 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000054 ;
                        owl:someValuesFrom log:LOG_1000114 ] ) ] ;
    skos:definition "business function that is realized in a freight forwarding service" .

log:LOG_1000053 a owl:Class ;
    rdfs:label "transportation business function" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom log:LOG_1000117 ],
        log:LOG_1000091 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000091 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000054 ;
                        owl:someValuesFrom log:LOG_1000117 ] ) ] ;
    skos:definition "business function that is realized in a transportation service" .

log:LOG_1000056 a owl:Class ;
    rdfs:label "consignee role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "role held by a person or business organization when it receives a shipment from a carrier and owns the shipment after the receipt" .

log:LOG_1000060 a owl:Class ;
    rdfs:label "distributor role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "role held by a person or business organization when it buys some material products from a manufacturer and resells them to a wholesaler" .

log:LOG_1000062 a owl:Class ;
    rdfs:label "retailer role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "role held by a person or business organization when it buys products (material product) from manufacturers or wholesalers and offers them for sale to customers who are the end users of the product" .

log:LOG_1000067 a owl:Class ;
    rdfs:label "freight forwarder role" ;
    rdfs:subClassOf log:LOG_1000065 ;
    skos:definition "A freight forwarder, or forwarding agent, is a person or company that organizes shipments for individuals or corporations to get goods from the manufacturer or producer to a market, customer or final point of distribution." .

log:LOG_1000070 a owl:Class ;
    rdfs:label "transportation service provider role" ;
    rdfs:subClassOf log:LOG_1000065 .

log:LOG_1000071 a owl:Class ;
    rdfs:label "supply chain agent role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom log:LOG_10001247 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( log:LOG_1000011 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000050 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                                                    owl:allValuesFrom log:LOG_1000020 ;
                                                    owl:onProperty obo:RO_0002351 ] ) ] ] ) ] ],
        log:LOG_1000054 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000054 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000054 ;
                        owl:someValuesFrom log:LOG_10001247 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000197 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_1000011 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000050 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                                                                owl:allValuesFrom log:LOG_1000020 ;
                                                                owl:onProperty obo:RO_0002351 ] ) ] ] ) ] ] ) ] ;
    skos:definition "role held by an agent that is a part of a supply chain system when it supplies material products or commercial services to other agents in the supply chain system" .

log:LOG_1000072 a owl:Class ;
    rdfs:label "wholesaler role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "role held by a person or business organization when it buys some product from a distributor and resells them to retailers" .

log:LOG_1000073 a owl:Class ;
    rdfs:label "cargo role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( log:LOG_1000143 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0000057 ;
                                                    owl:someValuesFrom log:LOG_1000021 ] ) ] ] ) ] ],
        obo:BFO_0000023 ;
    skos:definition "role held by a material entity when it is being transported or is planned to be transported by a carrier" .

log:LOG_1000075 a owl:Class ;
    rdfs:label "ship from location role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000183 ;
                                owl:someValuesFrom log:LOG_1000126 ] ) ] ],
        log:LOG_1000085 ;
    skos:definition "location role held by a geospatial site when it is the location at which some dispatch process occures" .

log:LOG_1000076 a owl:Class ;
    rdfs:label "ship to location role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000183 ;
                                owl:someValuesFrom log:LOG_1000124 ] ) ] ],
        log:LOG_1000085 ;
    skos:definition "location role held by a geospatial site when it is the location at which some receiving process occures" .

log:LOG_1000077 a owl:Class ;
    rdfs:label "supply chain node role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000183 ;
                                owl:someValuesFrom log:LOG_10001247 ] ) ] ],
        log:LOG_1000085 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000085 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000197 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000183 ;
                                            owl:someValuesFrom log:LOG_10001247 ] ) ] ] ) ] ;
    skos:definition "location role held by a geospatial site when it is the site some supply chain process" .

log:LOG_1000078 a owl:Class ;
    rdfs:label "material product role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:unionOf ( log:LOG_1000111 log:LOG_1000125 log:LOG_1000128 ) ] ] ) ] ],
        obo:BFO_0000023 ;
    skos:definition "role held by a material entity that is intended to be sold, or has been bought, or has been supplied" .

log:LOG_1000080 a owl:Class ;
    rdfs:label "lot role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:IAO_0000235 ;
                                owl:someValuesFrom log:LOG_1000005 ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom log:LOG_1000131 ] ) ] ],
        log:LOG_1000084 ;
    skos:definition "traceable resource unit role held by material entities that have a shared production or transformation history" .

log:LOG_1000081 a owl:Class ;
    rdfs:label "shipment role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002353 ;
                                owl:someValuesFrom log:LOG_1000126 ] ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom log:LOG_1000143 ;
            owl:onProperty obo:BFO_0000054 ],
        log:LOG_1000084 ;
    skos:definition "traceable resource unit role held by material entities when they undergo the same dispatch and receipt processes as prescribed by a bill of lading" .

log:LOG_1000082 a owl:Class ;
    rdfs:label "load role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom log:LOG_1000140 ] ) ] ],
        log:LOG_1000084 ;
    skos:definition "traceable resource unit role held by a number of material entities that have been transferred or transported together" .

log:LOG_1000083 a owl:Class ;
    rdfs:label "logistic unit role" ;
    rdfs:subClassOf log:LOG_1000084 ;
    skos:definition "traceable resource unit role held by a number of material entities that are packaged together for transport or storage" .

log:LOG_1000098 a owl:Class ;
    rdfs:label "warehousing plan specification" ;
    rdfs:subClassOf obo:IAO_0000104 ;
    skos:definition "plan specification that prescribes a warehousing process" .

log:LOG_1000104 a owl:Class ;
    rdfs:label "maintainable material item role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "role played by an asset (engineered system or material artifact) when there is a maintenance strategy prescribing its maintenance process" .

log:LOG_1000105 a owl:Class ;
    rdfs:label "material component role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        obo:BFO_0000023 ;
    skos:definition "role held by a material entity when it is a proper part of another material entity or is planned to be a proper part of another material entity" .

log:LOG_1000111 a owl:Class ;
    rdfs:label "buying business process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( log:LOG_1000001 log:LOG_1000029 ) ] ],
        log:LOG_1000130 ;
    skos:definition "business process wherein a financial instrument is used by an agent (buyer) to acquire ownership of a product or commercial service from another agent (seller) for the buyer itself or for another agent (customer)" .

log:LOG_1000114 a owl:Class ;
    rdfs:label "freight forwarding service" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000113 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom log:LOG_0000003 ] ) ],
        log:LOG_1000113 ;
    skos:definition "logistics service that consists of at least one freight forwarding process" .

log:LOG_1000117 a owl:Class ;
    rdfs:label "transportation service" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000113 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom log:LOG_1000143 ] ) ],
        log:LOG_1000113 ;
    skos:definition "business process that results in placing a material entity in the possession of some agent without changing the ownership until the material entity is sold",
        "logistics service that consists of at least one transport process" .

log:LOG_1000121 a owl:Class ;
    rdfs:label "packaging process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000130 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000029 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000059 ;
                                            owl:someValuesFrom log:LOG_1000095 ] ) ] ] ) ],
        log:LOG_1000130 ;
    skos:definition "business process of putting some products or some portion of material into a package according to a packaging plan specification" .

log:LOG_1000126 a owl:Class ;
    rdfs:label "shipment preparation process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000130 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000019 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000029 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002234 ;
                        owl:someValuesFrom log:LOG_1000051 ] ) ],
        log:LOG_1000130 ;
    skos:definition "business process in which some material entities are prepared to be transported together to a receiverÃ¢â‚¬â„¢s location" .

log:LOG_1000005 a owl:Class ;
    rdfs:label "lot number" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom log:LOG_1000037 ],
        obo:IAO_0020000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000219 ;
                        owl:someValuesFrom log:LOG_1000037 ] ) ] ;
    skos:definition "identifier that uniquely denotes a particular quantity of material entities that have shared production or transformation history" .

log:LOG_1000022 a owl:Class ;
    rdfs:label "service provider" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000064 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000064 ],
        log:LOG_1000020 ;
    skos:definition "person or organization which has a service provider role" .

log:LOG_1000028 a owl:Class ;
    rdfs:label "material component" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000105 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000105 ] ) ] ;
    skos:definition "material entity which has the material component role" .

log:LOG_1000034 a owl:Class ;
    rdfs:label "storage facility" ;
    rdfs:subClassOf log:LOG_1000032 ;
    skos:definition "facility that is designed to store materials or goods" .

log:LOG_1000041 a owl:Class ;
    rdfs:label "piece of transport equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000003 ],
        obo:BFO_0000030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000003 ] ) ] ;
    skos:definition "piece of equipment that has the function of holding, protecting, and securing a number of material entites for transportation purposes" .

log:LOG_1000047 a owl:Class ;
    rdfs:label "business organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000091 ],
        log:LOG_1000050 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000091 ] ) ] ;
    skos:definition "organization engaging in or planning to engage in any activity of buying and selling goods or services for a profit" .

log:LOG_1000055 a owl:Class ;
    rdfs:label "buyer role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "agent role held by a person or organization when it buys a product or a service" .

log:LOG_1000058 a owl:Class ;
    rdfs:label "customer role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "agent role held by a person or organization when it utilizes the product or receives the service or subscribes to the commercial service agreement" .

log:LOG_1000063 a owl:Class ;
    rdfs:label "supplier role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "agent role held by a person or organization when it offers to sell or provide products or services" .

log:LOG_1000106 a owl:Class ;
    rdfs:label "material resource role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        obo:BFO_0000023 ;
    skos:definition "role played by a material entity that consists in it being available to a person or group of agents or engineered system" .

log:LOG_1000128 a owl:Class ;
    rdfs:label "supplying business process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom log:LOG_1000020 ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000132 ;
                        owl:someValuesFrom log:LOG_1000112 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000029 ] ) ],
        log:LOG_1000130 ;
    skos:definition "business process wherein a product or service is supplied" .

log:LOG_1000144 a owl:Class ;
    rdfs:label "storage process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000011 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000059 ;
                                            owl:someValuesFrom obo:IAO_0000104 ] ) ] ] ) ],
        obo:BFO_0000015 ;
    skos:definition "planned process of putting and keeping material entities in a specified location for future use" .

pmd:PMD_0040030 a owl:Class ;
    rdfs:label "geospatial location" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000085 ],
        pmd:PMD_0040029 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000085 ] ) ] ;
    skos:definition "geospatial site that is the location of some material entity at some time or the site of some process" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    skos:editorialNote "LOGao supplies this PMDco-namespace class for compatibility. It is absent from the pinned PMDco release and should not be used as an authoritative PMDco backbone class without checking the upstream release."@en .

log:LOG_1000001 a owl:Class ;
    rdfs:label "commercial service agreement" ;
    rdfs:subClassOf log:LOG_1000000 ;
    skos:definition "agreement between a customer and service provider that is about some commercial service to be provided by the service provider in exchange for compensation from the customer" .

log:LOG_1000023 a owl:Class ;
    rdfs:label "supply chain agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000071 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000071 ],
        log:LOG_1000011 ;
    skos:definition "person or business organization who supplies material products or commercial services to other agents in a supply chain" .

log:LOG_1000038 a owl:Class ;
    rdfs:label "supply chain system" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( log:LOG_1000112 log:LOG_1000123 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002233 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0000059 ;
                                                    owl:someValuesFrom log:LOG_1000097 ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom log:LOG_1000020 ],
        obo:BFO_0000027 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000056 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0002233 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0000059 ;
                                                                owl:someValuesFrom log:LOG_1000097 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000056 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( log:LOG_1000112 log:LOG_1000123 ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002351 ;
                        owl:someValuesFrom log:LOG_1000020 ] ) ] ;
    skos:definition "engineered system composed of agents, facilties, machines, and information systems that is designed to deliver products and services to end customers through an engineered flow of information, material, and cash" .

log:LOG_1000057 a owl:Class ;
    rdfs:label "consignor role" ;
    rdfs:subClassOf log:LOG_1000054 ;
    skos:definition "role held by a business organization or person when it prepares, initiates, and consigns a shipment it owns" .

log:LOG_1000064 a owl:Class ;
    rdfs:label "service provider role" ;
    rdfs:subClassOf log:LOG_1000063 ;
    skos:definition "supplier role held by a person or organization when it offers to sell or provide a commercial service" .

log:LOG_1000065 a owl:Class ;
    rdfs:label "logistics service provider role" ;
    rdfs:subClassOf log:LOG_1000064 ;
    skos:definition "service provider role that is held by a business organization or person when it provides a logistics service" .

log:LOG_1000084 a owl:Class ;
    rdfs:label "traceable resource unit role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "role held by a number of uniquely identified material entities when they participate in some supply chain processes or production processes while some agent observes them and collects information about them for future retrieval" .

log:LOG_1000097 a owl:Class ;
    rdfs:label "supply chain plan specification" ;
    rdfs:subClassOf obo:IAO_0000104 ;
    skos:definition "plan specification that has one or more supply chain objective specifications as parts and that prescribes a supply chain process" .

log:LOG_1000143 a owl:Class ;
    rdfs:label "transport process" ;
    rdfs:subClassOf log:LOG_1000140 ;
    skos:definition "material location change process involving the movement of material entities by some piece of transport equipment" .

log:LOG_1000140 a owl:Class ;
    rdfs:label "material location change process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty [ owl:inverseOf obo:RO_0001015 ] ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000004 [ a owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000108 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:BFO_0000203 [ a owl:Class ;
                                                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                                                    owl:onProperty obo:BFO_0000221 ;
                                                                                    owl:someValuesFrom obo:BFO_0000008 ] [ a owl:Restriction ;
                                                                                    owl:onProperty [ owl:inverseOf obo:BFO_0000199 ] ;
                                                                                    owl:someValuesFrom obo:BFO_0000015 ] ) ] ) ] ] [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001025 ;
                                                    owl:someValuesFrom obo:BFO_0000029 ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty [ owl:inverseOf obo:RO_0001015 ] ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000004 [ a owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000108 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:BFO_0000203 [ a owl:Restriction ;
                                                                        owl:onProperty obo:BFO_0000223 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( obo:BFO_0000008 [ a owl:Restriction ;
                                                                                            owl:onProperty [ owl:inverseOf obo:BFO_0000199 ] ;
                                                                                            owl:someValuesFrom obo:BFO_0000015 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001025 ;
                                                    owl:someValuesFrom obo:BFO_0000029 ] ) ] ] ) ] ],
        obo:BFO_0000015 ;
    skos:definition "planned process that results in a material entity moving from one physical location to another" .

log:LOG_1000085 a owl:Class ;
    rdfs:label "location role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Class ;
                                owl:unionOf ( [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000183 ;
                                            owl:someValuesFrom obo:BFO_0000015 ] [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0001015 ;
                                            owl:someValuesFrom obo:BFO_0000040 ] ) ] ) ] ],
        obo:BFO_0000023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000023 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000197 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0040029 [ a owl:Class ;
                                            owl:unionOf ( [ a owl:Restriction ;
                                                        owl:onProperty obo:BFO_0000183 ;
                                                        owl:someValuesFrom obo:BFO_0000015 ] [ a owl:Restriction ;
                                                        owl:onProperty obo:RO_0001015 ;
                                                        owl:someValuesFrom obo:BFO_0000040 ] ) ] ) ] ] ) ] ;
    skos:definition "role held by a geospatial site when it is the location of some material entity at some time or the site of some process" .

log:LOG_1000091 a owl:Class ;
    rdfs:label "business function" ;
    rdfs:subClassOf obo:BFO_0000034 ;
    skos:definition "function of an organization to partake in for profit activities as prescribed by the objectives specified by that organization" .

log:LOG_1000123 a owl:Class ;
    rdfs:label "product production process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "business process that consists of at least one manufacturing process through which raw materials and components are transformed or modified to create a material product" .

log:LOG_10001247 a owl:Class ;
    rdfs:label "supply chain process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000059 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( log:LOG_1000097 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002502 ;
                                owl:someValuesFrom log:LOG_1000023 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom log:LOG_1000023 ],
        log:LOG_1000130 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( log:LOG_1000130 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000023 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000059 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_1000097 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0002502 ;
                                            owl:someValuesFrom log:LOG_1000023 ] ) ] ] ) ] ;
    skos:definition "planned process in which a supply chain plan specification is realized by a number of supply chain agents" .

log:LOG_1000131 a owl:Class ;
    rdfs:label "manufacturing process" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom log:LOG_1000011 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000059 ;
                                            owl:someValuesFrom obo:IAO_0000104 ] ) ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002233 ;
                        owl:someValuesFrom obo:BFO_0000040 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002234 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( log:LOG_1000028 log:LOG_1000029 log:LOG_1000030 ) ] ] ) ],
        obo:BFO_0000015 ;
    skos:definition "planned process that consists of a structured set of operations through which input material is transformed or modified" .

log:LOG_1000020 a owl:Class ;
    rdfs:label "supplier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000063 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000063 ],
        log:LOG_1000011 ;
    skos:definition "person or organization which has a supplier role" .

log:LOG_1000112 a owl:Class ;
    rdfs:label "commercial service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000117 ;
            owl:someValuesFrom log:LOG_1000128 ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000004 ;
            owl:someValuesFrom log:LOG_1000001 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom log:LOG_1000022 ],
        log:LOG_1000130 ;
    skos:definition "business process that consists of a service provisioning process and a consumption process" .

log:LOG_1000113 a owl:Class ;
    rdfs:label "logistics service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000117 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( log:LOG_1000118 log:LOG_1000121 log:LOG_1000143 ) ] ],
        log:LOG_1000112 ;
    skos:definition "commercial service that consists of at least one transport process, packaging process, freight forwarding, or storage process" .

log:LOG_1000029 a owl:Class ;
    rdfs:label "material product" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000078 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000078 ] ) ] ;
    skos:definition "material entity which has the material product role" .

log:LOG_1000050 a owl:Class ;
    rdfs:label "organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000235 ;
            owl:someValuesFrom log:LOG_1000006 ],
        obo:OBI_0000245 ;
    skos:definition "An organization is an immaterial entity that has the organisation role and there exists some sort of legal framework that recognises the entity and its continued existence." ;
    matsus:alignmentRelation "narrower than OBI organization" ;
    skos:editorialNote "LOG organization is a distinct specialization of OBI organization. The W3C org:FormalOrganization class supplies no superclass."@en .

pmd:PMD_0040029 a owl:Class ;
    rdfs:label "geospatial site" ;
    rdfs:subClassOf obo:BFO_0000029 ;
    skos:definition "site at or near the surface of the earth" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    dcterms:source <https://github.com/materialdigital/logistics-application-ontology/commit/0c89424ffc17096599d5bfdcfba783686494d49e> ;
    skos:editorialNote "LOGao supplies this PMDco-namespace class for compatibility. It is absent from the pinned PMDco release and should not be used as an authoritative PMDco backbone class without checking the upstream release."@en .

log:LOG_1000054 a owl:Class ;
    rdfs:label "agent role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "role that someone or something has when they act on behalf of a person, engineered system or a group of agents" ;
    matsus:alignmentRelation "narrower than/close to org:Role, authoritative under BFO role" ;
    skos:editorialNote "This agent role uses the BFO role category. Correspondence to web organization roles does not import the external org/SKOS role hierarchy."@en .

log:LOG_1000130 a owl:Class ;
    rdfs:label "business process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( log:LOG_1000011 [ a owl:Restriction ;
                                owl:onProperty log:LOG_1900001 ;
                                owl:someValuesFrom log:LOG_1000047 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002233 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:OBI_0000260 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000059 ;
                                owl:someValuesFrom obo:IAO_0000104 ] ) ] ],
        obo:BFO_0000015 ;
    skos:definition "planned process which is prescribed by a plan specification with one or more objectives specified by a business organization" .

log:LOG_1000011 a owl:Class ;
    rdfs:label "agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_1000054 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom log:LOG_1000054 ] ) ] ;
