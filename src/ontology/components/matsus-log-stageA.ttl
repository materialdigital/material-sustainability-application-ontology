    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000219 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_1000050 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000196 ;
                                            owl:someValuesFrom obo:OBI_0000571 ] ) ] ] ) ] ;
    matsus:alignmentRelation "related extension" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "subclassing" .

log:LOG_0080001 a owl:Class ;
