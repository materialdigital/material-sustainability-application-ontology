                                    owl:onProperty obo:IAO_0000219 ;
                                    owl:someValuesFrom log:LOG_1000050 ] ) ] [ a owl:Restriction ;
                        owl:hasValue pmd:PMD_0040128 ;
                        owl:onProperty pmd:PMD_0000004 ] ) ] ;
    skos:definition "identifer that uniquely identifies a business organization or a geospatial location and complies with GS1 GLN coding scheme" ;
    matsus:alignmentRelation "related extension" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "subclassing" .

