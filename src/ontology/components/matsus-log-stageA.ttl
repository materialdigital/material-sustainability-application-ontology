log:LOG_1000079 a owl:Class ;
    rdfs:label "raw material role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( log:LOG_1000123 [ a owl:Class ;
                                owl:intersectionOf ( log:LOG_1000131 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000132 ;
                                            owl:someValuesFrom log:LOG_1000123 ] ) ] ) ] ;
            owl:onProperty obo:BFO_0000054 ],
        [ a owl:Restriction ;
