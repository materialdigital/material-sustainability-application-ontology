obo:BFO_0000082 a owl:ObjectProperty .
obo:BFO_0000196 a owl:ObjectProperty .
obo:BFO_0000197 a owl:ObjectProperty .
obo:RO_0002502 a owl:ObjectProperty .

pmd:PMD_0040121 a owl:ObjectProperty ;
    rdfs:label "specifies role"@en ;
    dcterms:source "Supplied via LOGao; absent from the PMDco release in use for comparison." ;
    rdfs:comment "Namespace/version anomaly: this PMDco-namespace object property is supplied through LOGao but is absent from the compared PMDco release used for validation. It is retained for LOGao compatibility only and must not be treated as a stable PMDco backbone property without manual review." ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range obo:BFO_0000023 ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    owl:inverseOf pmd:PMD_0040122 ;
    skos:editorialNote "LOG compatibility exception" ;
    skos:note "needs human review" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "direct reuse" ;
    matsus:integrationNote "LOG supplies this PMDco-namespace object property; added without altering existing PMDco hierarchy or adding new Mat.Sus modelling commitments." .

pmd:PMD_0040129 a owl:Class ;
    rdfs:label "supply chain objective specification" ;
    dcterms:source "Supplied via LOGao; absent from the PMDco release in use for comparison." ;
    rdfs:comment "Namespace/version anomaly: this PMDco-namespace class is present in this combined ontology via LOGao, but is absent from the compared PMDco release used for validation (pmdco-full.ttl). It is retained for LOGao compatibility only, must not be treated as a stable PMDco backbone anchor, and should not be used to justify broader PMDco restructuring without manual review." ;
    rdfs:subClassOf obo:IAO_0000005 ;
    skos:definition "objective specification that prescribes what the outcome of a supply chain process should be" ;
    skos:editorialNote "LOG compatibility exception" ;
    skos:note "needs human review" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "direct reuse" ;
    matsus:integrationNote "LOG introduces this PMDco-namespace extension class; integrated without altering existing PMDco superclass logic." .

pmd:PMD_0040151 a owl:Class ;
    rdfs:label "storage function" ;
    dcterms:source "Supplied via LOGao; absent from the PMDco release in use for comparison." ;
    rdfs:comment "Namespace/version anomaly: this PMDco-namespace class is present in this combined ontology via LOGao, but is absent from the compared PMDco release used for validation (pmdco-full.ttl). It is retained for LOGao compatibility only, must not be treated as a stable PMDco backbone anchor, and should not be used to justify broader PMDco restructuring without manual review." ;
    rdfs:subClassOf obo:BFO_0000034 ;
    skos:definition "function of an material entity to store other material entities" ;
    skos:editorialNote "LOG compatibility exception" ;
    skos:note "needs human review" ;
    matsus:alignmentRelation "PMDco namespace extension from LOGao" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "direct reuse" ;
    matsus:integrationNote "LOG introduces this PMDco-namespace extension class; integrated without altering existing PMDco superclass logic." .

log:LOG_0000000 a owl:Class ;
    rdfs:label "industrial inventory" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_0000001 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom log:LOG_0000001 ],
        log:LOG_1000030 ;
    skos:definition "material product, material component, raw material, or material artifact that is ready to be sold or used and is stored in a storage facility or on factory floor" ;
    matsus:alignmentRelation "related extension" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "subclassing" .

log:LOG_0000002 a owl:Class ;
    rdfs:label "consigning process" ;
    rdfs:subClassOf log:LOG_1000130 ;
    skos:definition "business process that results in placing a material entity in the possession of some agent without changing the ownership until the material entity is sold" ;
    matsus:alignmentRelation "related extension" ;
    matsus:integrationBasis "b) LOGao logic" ;
    matsus:integrationMethod "subclassing" .

log:LOG_0080000 a owl:Class ;
