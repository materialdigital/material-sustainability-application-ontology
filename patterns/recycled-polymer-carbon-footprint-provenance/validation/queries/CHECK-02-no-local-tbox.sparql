PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?entity ?predicate WHERE {
  ?entity ?predicate ?object .
  FILTER(STRSTARTS(STR(?entity), "https://w3id.org/pmd/matsus/pattern/recycled-polymer-carbon-footprint-provenance/hdpe/"))
  FILTER(?predicate IN (rdfs:subClassOf, owl:equivalentClass) ||
    (?predicate = rdf:type && ?object IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty)))
}
