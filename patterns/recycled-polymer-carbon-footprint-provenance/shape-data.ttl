# Virgin supply, mixing and bottle manufacture
p2:virginHDPEBatch a pmd:PMD_0050007, pmd:PMD_0000891, matsus:MATSUS_0000030 ; rdfs:label "Mat. independent supplier virgin-HDPE batch (700 kg)"@en .
p2:blendedHDPEBatch a pmd:PMD_0050007, pmd:PMD_0000891 ; rdfs:label "Mat. 30 % recycled / 70 % virgin HDPE blend batch (1000 kg)"@en .
p2:finalBottleBatch a pmd:PMD_0050007, obo:BFO_0000027 ; rdfs:label "Obj./Mat. synthetic non-food detergent/shampoo bottle batch (1000 kg)"@en .
p2:mixing a pmd:PMD_0000778 ; rdfs:label "Proc. executed mixing of recycled and virgin HDPE"@en ; obo:OBI_0000293 p2:recycledPelletBatch, p2:virginHDPEBatch ; obo:OBI_0000299 p2:blendedHDPEBatch .
p2:extrusionBlowMolding a pmd:PMD_0200007 ; rdfs:label "Proc. executed extrusion blow molding of non-food bottles"@en ; obo:OBI_0000293 p2:blendedHDPEBatch ; obo:OBI_0000299 p2:finalBottleBatch .

p2:recycledContentDatum a matsus:MATSUS_0000081 ; rdfs:label "Data. illustrative 30 % recycled mass fraction"@en ; obo:IAO_0000136 p2:blendedHDPEBatch, p2:finalBottleBatch, p2:recycledPelletBatch, p2:virginHDPEBatch ; dcterms:source p2:mixingBatchRecord ; obo:OBI_0001938 p2:recycledContentValue .
