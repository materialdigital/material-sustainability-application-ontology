# PP-contamination characterization
p2:ppContaminationCharacterization a pmd:PMD_0000552 ; rdfs:label "Proc. illustrative PP-contamination characterization"@en ; obo:OBI_0000293 p2:recycledPelletBatch, p2:syntheticPPCharacterizationMethod ; obo:OBI_0000299 p2:ppContaminationDatum .
p2:syntheticPPCharacterizationMethod a obo:IAO_0000104 ; rdfs:label "Spec. illustrative PP-contamination characterization method (not validated)"@en ; obo:IAO_0000136 p2:ppContaminationCharacterization .
p2:ppDryMassBasis a obo:IAO_0000033 ; rdfs:label "Spec. PP mass fraction of dry recovered-pellet sample"@en ; obo:IAO_0000136 p2:recycledPelletBatch, p2:ppMassFractionQuality .
p2:ppMassFractionQuality a pmd:PMD_0020102 ; rdfs:label "Qual. PP mass fraction in the synthetic recovered-pellet batch"@en ; obo:RO_0000052 p2:recycledPelletBatch .
p2:ppContaminantMaterial a pmd:PMD_0050009 ; rdfs:label "Mat. polypropylene constituent represented by the synthetic characterization result"@en .
p2:ppContaminationDatum a obo:IAO_0000109 ; rdfs:label "Data. illustrative PP contamination: 0.8 % by dry mass"@en ; obo:IAO_0000136 p2:recycledPelletBatch, p2:ppMassFractionQuality, p2:ppContaminantMaterial, p2:ppDryMassBasis ; dcterms:source p2:syntheticCharacterizationReport ; obo:OBI_0001938 p2:ppContaminationValue .
p2:ppContaminationValue a pmd:PMD_0080205 ; obo:OBI_0001927 p2:ppMassFractionQuality ; qudt:numericValue "0.8"^^xsd:decimal ; qudt:hasUnit unit:PERCENT .
p2:syntheticCharacterizationReport a obo:IAO_0000310 ; rdfs:label "Inf. synthetic PP-contamination characterization report"@en ; obo:IAO_0000136 p2:ppContaminationCharacterization, p2:recycledPelletBatch, p2:ppContaminationDatum, p2:syntheticPPCharacterizationMethod .

# Recycling carbon-footprint provenance
p2:recyclingCFSpecification a matsus:MATSUS_0000068 ; rdfs:label "Spec. synthetic recycling CF quantification specification"@en ; obo:BFO_0000051 p2:recyclingFunctionalUnit, p2:recyclingReferenceFlow, p2:recyclingSystemBoundary .
p2:recyclingFunctionalUnit a matsus:MATSUS_0000069 ; rdfs:label "Spec. process the one synthetic 350 kg post-consumer HDPE batch"@en .
p2:recyclingReferenceFlow a matsus:MATSUS_0000070 ; rdfs:label "Spec. reference flow: the resulting 300 kg rHDPE pellet batch"@en ; obo:IAO_0000136 p2:recycledPelletBatch, p2:pelletMassDatum .
p2:recyclingSystemBoundary a matsus:MATSUS_0000071 ; rdfs:label "Spec. gate-to-gate: sorting through pelletizing; excludes collection, transport, prior use and bottle manufacture"@en ; obo:IAO_0000136 p2:mechanicalRecycling .
p2:recyclingSystemModel a matsus:MATSUS_0000072 ; rdfs:label "Inf. synthetic mechanical-recycling system model"@en ; obo:IAO_0000136 p2:mechanicalRecycling, p2:postConsumerHDPEBatch, p2:recycledPelletBatch .

p2:gridElectricityFactorBasis a obo:IAO_0000033 ; rdfs:label "Spec. synthetic grid-electricity factor basis: kg CO2e per kWh; no geography, time or technology representativeness claim"@en ; obo:IAO_0000136 matsus:MATSUS_0000078, matsus:MATSUS_0000079 .
p2:syntheticEmissionFactorSource a obo:IAO_0000310 ; rdfs:label "Inf. synthetic grid-electricity factor source; not an empirical database"@en ; obo:IAO_0000136 p2:gridElectricityEmissionFactorDatum, p2:gridElectricityEmissionFactorValue, p2:gridElectricityFactorBasis .
p2:gridElectricityEmissionFactorDatum a obo:IAO_0000027 ; rdfs:label "Data. synthetic test factor: 0.4 kg CO2e per kWh"@en ; dcterms:source p2:syntheticEmissionFactorSource ; obo:IAO_0000136 p2:recyclingCFQuantification, p2:bottleCFQuantification, p2:gridElectricityFactorBasis, matsus:MATSUS_0000078, matsus:MATSUS_0000079 ; obo:OBI_0001938 p2:gridElectricityEmissionFactorValue .
p2:gridElectricityEmissionFactorValue a pmd:PMD_0080205 ; qudt:numericValue "0.4"^^xsd:decimal ; qudt:hasUnit unit:KiloGM-PER-KiloW-HR .

p2:recyclingLCIAnalysis a matsus:MATSUS_0000066 ; rdfs:label "Proc. synthetic recycling inventory compilation"@en ; obo:OBI_0000293 p2:sortingInventoryRecord, p2:shreddingInventoryRecord, p2:washingInventoryRecord, p2:dryingInventoryRecord, p2:extrusionInventoryRecord, p2:pelletizingInventoryRecord, p2:batchWeighingRecord ; obo:OBI_0000299 p2:compiledRecyclingInventory .
p2:compiledRecyclingInventory a obo:IAO_0000310 ; rdfs:label "Inf. compiled synthetic recycling inventory dataset"@en ; obo:IAO_0000136 p2:mechanicalRecycling ; dcterms:source p2:sortingInventoryRecord, p2:shreddingInventoryRecord, p2:washingInventoryRecord, p2:dryingInventoryRecord, p2:extrusionInventoryRecord, p2:pelletizingInventoryRecord, p2:batchWeighingRecord .
p2:recyclingCFQuantification a pmd:PMD_0000583 ; rdfs:label "Proc. black-box synthetic recycling CF computation"@en ; obo:OBI_0000293 p2:recyclingSystemModel, p2:recyclingCFSpecification, p2:compiledRecyclingInventory, p2:gridElectricityEmissionFactorDatum ; obo:OBI_0000299 p2:sortingCFResult, p2:shreddingCFResult, p2:washingCFResult, p2:dryingCFResult, p2:extrusionCFResult, p2:pelletizingCFResult, p2:recycledPelletCFResult .

