# Candidate method source and explicit limitations
p2:pefCircularFootprintFormulaCandidate a obo:IAO_0000104 ; rdfs:label "Spec. EU PEF Circular Footprint Formula candidate allocation method (not applied)"@en ; dcterms:source <http://data.europa.eu/eli/reco/2021/2279/oj> ; obo:IAO_0000136 p2:recyclingCFSpecification, p2:bottleCFSpecification .
p2:knownLimitationsRecord a obo:IAO_0000310 ; rdfs:label "Inf. known semantic and evidence limitations"@en ; obo:BFO_0000051 p2:shreddingTypeGap, p2:dryingTypeGap, p2:meltFiltrationTypeGap, p2:pelletizingTypeGap, p2:cffNotAppliedLimitation, p2:supplierComparabilityLimitation, p2:syntheticEvidenceLimitation, p2:cfMethodCompletenessLimitation .
p2:shreddingTypeGap a obo:IAO_0000030 ; rdfs:label "Limitation. no exact pinned shredding class"@en ; rdfs:comment "Shredding uses the verified PMDco separating superclass."@en ; obo:IAO_0000136 p2:shredding .
p2:dryingTypeGap a obo:IAO_0000030 ; rdfs:label "Limitation. no exact pinned polymer-drying class"@en ; rdfs:comment "Drying uses the verified PMDco manufacturing-process superclass."@en ; obo:IAO_0000136 p2:drying .
p2:meltFiltrationTypeGap a obo:IAO_0000030 ; rdfs:label "Limitation. no exact pinned melt-filtration class"@en ; rdfs:comment "The integrated operation is typed only as PMDco extrusion."@en ; obo:IAO_0000136 p2:extrusionMeltFiltration .
p2:pelletizingTypeGap a obo:IAO_0000030 ; rdfs:label "Limitation. no exact pinned pelletizing/regranulation class"@en ; rdfs:comment "Pelletizing uses the verified PMDco manufacturing-process superclass."@en ; obo:IAO_0000136 p2:pelletizing .
p2:cffNotAppliedLimitation a obo:IAO_0000030 ; rdfs:label "Limitation. PEF CFF is only a candidate method"@en ; rdfs:comment "No CFF parameters or calculations are implemented, and no PEF compliance is claimed."@en ; obo:IAO_0000136 p2:pefCircularFootprintFormulaCandidate .
p2:supplierComparabilityLimitation a obo:IAO_0000030 ; rdfs:label "Limitation. supplier CF comparability is not established"@en ; rdfs:comment "The supplier model is not exposed; contributes-to asserts neither arithmetic aggregation nor methodological comparability."@en ; obo:IAO_0000136 p2:virginSupplierDeclaration, p2:virginSupplierCFResult, p2:finalBottleCFResult .
p2:syntheticEvidenceLimitation a obo:IAO_0000030 ; rdfs:label "Limitation. all values and source records are synthetic"@en ; rdfs:comment "Numbers exercise the graph only; they are not measured data, validated methods, certified mass balance, or verified CF results."@en ; obo:IAO_0000136 p2:compiledRecyclingInventory, p2:compiledBottleInventory, p2:ppContaminationDatum .
p2:cfMethodCompletenessLimitation a obo:IAO_0000030 ; rdfs:label "Limitation. CF computational method and completeness evidence are absent"@en ; rdfs:comment "The black-box computations do not disclose equations, allocation choices, completeness reconciliation, uncertainty or a reproducible derivation of the aggregate results."@en ; obo:IAO_0000136 p2:recyclingCFQuantification, p2:virginSupplierCFQuantification, p2:bottleCFQuantification .
