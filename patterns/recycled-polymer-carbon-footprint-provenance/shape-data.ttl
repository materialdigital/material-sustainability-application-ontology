@prefix ceon-process: <http://w3id.org/CEON/ontology/process/> .

# Physical batches and executed recycling genealogy
p2:postConsumerHDPEBatch a pmd:PMD_0050007, pmd:PMD_0000891 ; rdfs:label "Mat. synthetic post-consumer HDPE packaging batch (350 kg)"@en .
p2:sortedHDPEBatch a pmd:PMD_0050007, pmd:PMD_0000891 ; rdfs:label "Mat. sorted HDPE stream (340 kg)"@en .
p2:shreddedHDPEFlakeBatch a pmd:PMD_0050007, pmd:PMD_0000891 ; rdfs:label "Mat. shredded HDPE flake stream (335 kg)"@en .
p2:washedHDPEFlakeBatch a pmd:PMD_0050007, pmd:PMD_0000891 ; rdfs:label "Mat. washed HDPE flake stream (320 kg)"@en .
p2:driedHDPEFlakeBatch a pmd:PMD_0050007, pmd:PMD_0000891 ; rdfs:label "Mat. dried HDPE flake stream (315 kg)"@en .
p2:filteredHDPEExtrudateBatch a pmd:PMD_0050007 ; rdfs:label "Mat. melt-filtered HDPE extrudate stream (310 kg)"@en .
p2:recycledPelletBatch a pmd:PMD_0050007, pmd:PMD_0000891, matsus:MATSUS_0000002, matsus:MATSUS_0000003 ; rdfs:label "Mat. recovered rHDPE pellet batch (300 kg)"@en .
p2:washWater a pmd:PMD_0000000 ; rdfs:label "Mat. synthetic washing-water input"@en .
p2:washDetergent a pmd:PMD_0000000 ; rdfs:label "Mat. synthetic detergent input"@en .
p2:washWastewater a pmd:PMD_0000000 ; rdfs:label "Mat. synthetic washing wastewater output"@en .

p2:mechanicalRecycling a ceon-process:RecycleProcess, matsus:MATSUS_0000000 ; rdfs:label "Proc. executed composite mechanical recycling process"@en ; obo:OBI_0000293 p2:postConsumerHDPEBatch ; obo:OBI_0000299 p2:recycledPelletBatch ; obo:BFO_0000117 p2:sorting, p2:shredding, p2:washing, p2:drying, p2:extrusionMeltFiltration, p2:pelletizing .
p2:sorting a matsus:MATSUS_0000016 ; rdfs:label "Proc. executed polymer sorting"@en ; obo:OBI_0000293 p2:postConsumerHDPEBatch ; obo:OBI_0000299 p2:sortedHDPEBatch .
p2:shredding a pmd:PMD_0000927 ; rdfs:label "Proc. executed shredding (PMDco separating)"@en ; obo:OBI_0000293 p2:sortedHDPEBatch ; obo:OBI_0000299 p2:shreddedHDPEFlakeBatch .
p2:washing a pmd:PMD_0000560 ; rdfs:label "Proc. executed flake washing"@en ; obo:OBI_0000293 p2:shreddedHDPEFlakeBatch, p2:washWater, p2:washDetergent ; obo:OBI_0000299 p2:washedHDPEFlakeBatch, p2:washWastewater .
p2:drying a pmd:PMD_0000833 ; rdfs:label "Proc. executed flake drying (PMDco manufacturing process)"@en ; obo:OBI_0000293 p2:washedHDPEFlakeBatch ; obo:OBI_0000299 p2:driedHDPEFlakeBatch .
p2:extrusionMeltFiltration a pmd:PMD_0200004 ; rdfs:label "Proc. executed extrusion with integrated melt filtration"@en ; obo:OBI_0000293 p2:driedHDPEFlakeBatch ; obo:OBI_0000299 p2:filteredHDPEExtrudateBatch .
p2:pelletizing a pmd:PMD_0000833 ; rdfs:label "Proc. executed pelletizing/regranulation (PMDco manufacturing process)"@en ; obo:OBI_0000293 p2:filteredHDPEExtrudateBatch ; obo:OBI_0000299 p2:recycledPelletBatch .

# Batch quantities
