p2:extrudateMassDatum a obo:IAO_0000109 ; rdfs:label "Data. synthetic filtered-extrudate mass"@en ; obo:IAO_0000136 p2:filteredHDPEExtrudateBatch ; dcterms:source p2:batchWeighingRecord ; obo:OBI_0001938 p2:extrudateMassValue .
p2:extrudateMassValue a pmd:PMD_0080205 ; qudt:numericValue "310"^^xsd:decimal ; qudt:hasUnit unit:KiloGM .
p2:pelletMassDatum a obo:IAO_0000109 ; rdfs:label "Data. synthetic rHDPE-pellet mass"@en ; obo:IAO_0000136 p2:recycledPelletBatch ; dcterms:source p2:batchWeighingRecord ; obo:OBI_0001938 p2:pelletMassValue .
