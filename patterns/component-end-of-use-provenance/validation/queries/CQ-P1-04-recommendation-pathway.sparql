PREFIX matsus: <https://w3id.org/pmd/matsus/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
SELECT ?component ?recommendation ?recommendedProcess WHERE {
  ?assessment a matsus:MATSUS_0000062 ;
              matsus:MATSUS_0000060 ?component ;
              obo:OBI_0000299 ?recommendation .
  ?recommendation a matsus:MATSUS_0000063 .
  OPTIONAL { ?recommendation matsus:MATSUS_0000064 ?recommendedProcess }
}
ORDER BY ?component
